<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <title>EndAuxRacism</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Mono:wght@300;400&display=swap"
            rel="stylesheet"
        />
        <style>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                background: #0a0a0a;
                color: #f0f0f0;
                font-family: "DM Mono", monospace;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 24px 20px;
                gap: 0;
                text-align: center;
                overflow-x: hidden;
            }

            h1 {
                font-family: "Syne", sans-serif;
                font-weight: 800;
                font-size: clamp(1.3rem, 5.5vw, 3.2rem);
                color: #ffbcff;
                letter-spacing: -0.03em;
                margin-bottom: 10px;
                line-height: 1.1;
                padding: 0 16px;
                word-break: break-word;
            }

            p.tagline {
                color: #555;
                font-size: clamp(0.72rem, 3vw, 0.88rem);
                margin-bottom: 32px;
                letter-spacing: 0.02em;
            }

            .login-wrap {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 14px;
                width: 100%;
                max-width: 320px;
            }

            a.login-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                background: #ffbcff;
                color: #1a0020;
                font-family: "Syne", sans-serif;
                font-weight: 700;
                font-size: clamp(0.78rem, 3.5vw, 0.9rem);
                text-decoration: none;
                padding: 13px 28px;
                border-radius: 100px;
                width: 100%;
                transition: background 0.2s, transform 0.1s;
                white-space: nowrap;
            }

            a.login-btn:hover {
                background: #e89fe8;
                transform: scale(1.03);
            }

            .invite-hint {
                color: #444;
                font-size: clamp(0.62rem, 2.5vw, 0.7rem);
                line-height: 1.6;
                max-width: 260px;
            }

            @media (max-width: 300px) {
                h1 { font-size: 1.2rem; padding: 0 8px; }
                a.login-btn { padding: 11px 18px; font-size: 0.72rem; }
                .login-wrap { max-width: 100%; }
            }
        </style>
    </head>
    <body>
        <h1>EndAuxRacism</h1>
        <p class="tagline">let all the dawgs on aux</p>
        <div class="login-wrap">
            <a href="/auth/spotify" class="login-btn">
                <!-- Spotify logo icon -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path
                        d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"
                    />
                </svg>
                Login with Spotify
            </a>
            <p class="invite-hint">or ask your friend for an invite link to their room</p>
        </div>
    </body>
</html>
