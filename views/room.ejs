            // ── Guest now-playing ─────────────────────────────────────────────────────
            function updateGuestNowPlaying(song) {
                const art    = document.getElementById('guest-np-art');
                const name   = document.getElementById('guest-np-name');
                const artist = document.getElementById('guest-np-artist');
                if (!art) return;
                if (song.image) { art.src = song.image; art.style.opacity = '1'; }
                if (name)   { name.textContent   = song.name;   name.style.color = ''; }
