            async function transferToDevice(targetDeviceId, deviceName) {
                const list  = document.getElementById('connect-device-list');
                const error = document.getElementById('connect-modal-error');
                error.style.display = 'none';
                list.innerHTML = `<div class="connect-loading">Connecting to ${deviceName}...</div>`;

                try {
                    const res  = await fetch('/spotify/transfer', {
                        method:  'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body:    JSON.stringify({ deviceId: targetDeviceId, play: isPlaying }),
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'Transfer failed');

                    showToast(`Playing on ${deviceName}`);

                    // If we're leaving the SDK player, switch on polling immediately
                    if (targetDeviceId !== deviceId) {
                        activeDeviceId = targetDeviceId;
                        sdkIsActiveDevice = false;
                        startPolling();
                        setStatus('info', `▶ Playing on ${deviceName}`);
                    } else {
                        // Transferring back to the browser SDK
                        activeDeviceId = deviceId;
                        sdkIsActiveDevice = true;
                        stopPolling();
                    }

                    closeConnectModal();
                } catch (e) {
                    list.innerHTML = '';
                    error.textContent = e.message;
                    error.style.display = '';
                }
            }

            function setStatus(type, msg) {
                const el = document.getElementById('sdk-status');
                if (el) { el.textContent = msg; el.className = type; }
                const bar = document.getElementById('sdk-status-bar');
