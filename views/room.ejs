            async function loadDevices() {
                const list  = document.getElementById('connect-device-list');
                const error = document.getElementById('connect-modal-error');
                error.style.display = 'none';
                list.innerHTML = '<div class="connect-loading">Scanning for devices...</div>';

                try {
                    const res  = await fetch('/spotify/devices');
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'Failed to load devices');

                    const devices = data.devices || [];
                    list.innerHTML = '';

                    if (devices.length === 0) {
                        list.innerHTML = `<div class="connect-empty">
                            No devices found. Open Spotify on your phone or desktop and try again.
                        </div>`;
                        return;
                    }

                    devices.forEach(device => {
                        const isThisSDK = device.id === deviceId;
                        const item = document.createElement('div');
                        item.className = 'connect-device-item' + (device.is_active ? ' active' : '');
                        item.innerHTML = `
                            <span class="connect-device-icon">${deviceIcon(device.type)}</span>
                            <span class="connect-device-info">
                                <span class="connect-device-name">${device.name}${isThisSDK ? ' <em>(this browser)</em>' : ''}</span>
                                <span class="connect-device-type">${device.type}${device.volume_percent != null ? ` · ${device.volume_percent}%` : ''}</span>
                            </span>
                            ${device.is_active
                                ? '<span class="connect-device-badge">Playing here</span>'
                                : '<button class="btn-connect-select">Switch</button>'}
                        `;

                        if (!device.is_active) {
                            item.querySelector('.btn-connect-select').addEventListener('click', () => {
                                transferToDevice(device.id, device.name);
                            });
                        }
                        list.appendChild(item);
                    });
                } catch (e) {
                    list.innerHTML = '';
                    error.textContent = e.message;
                    error.style.display = '';
                }
            }

            async function transferToDevice(targetDeviceId, deviceName) {
                const list  = document.getElementById('connect-device-list');
                const error = document.getElementById('connect-modal-error');
                error.style.display = 'none';
                list.innerHTML = `<div class="connect-loading">Connecting to ${deviceName}...</div>`;

                try {
                    const res  = await fetch('/spotify/transfer', {
                        method:  'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body:    JSON.stringify({ deviceId: targetDeviceId, play: isPlaying }),
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'Transfer failed');

                    showToast(`Playing on ${deviceName}`);

                    // If we're leaving the SDK player, switch on polling immediately
                    if (targetDeviceId !== deviceId) {
                        activeDeviceId = targetDeviceId;
                        sdkIsActiveDevice = false;
                        startPolling();
                        setStatus('info', `▶ Playing on ${deviceName}`);
                    } else {
                        // Transferring back to the browser SDK
                        activeDeviceId = deviceId;
                        sdkIsActiveDevice = true;
                        stopPolling();
                    }

                    closeConnectModal();
                } catch (e) {
                    list.innerHTML = '';
                    error.textContent = e.message;
                    error.style.display = '';
                }
            }

