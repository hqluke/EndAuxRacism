            // ── Play a track ──────────────────────────────────────────────────────────
            let hasPlayedOnce = false; // tracks whether the SDK has played anything yet

            // Right after the Web Playback SDK's 'ready' event fires, activeDeviceId is
            // set client-side, but Spotify's backend can take a moment to finish
            // registering the device — PUT /me/player/play briefly 404s ("device not
            // found") even though the device_id is valid. A couple of short retries
            // absorb that instead of silently failing and making the user click again.
            async function sendPlayRequest(trackUri, targetDeviceId, attempt = 0) {
                const res = await fetch('/spotify/play', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ trackUri, deviceId: targetDeviceId }),
                });
                if (res.ok) return true;
                if (attempt < 2) {
                    await new Promise(r => setTimeout(r, 400 * (attempt + 1)));
                    return sendPlayRequest(trackUri, targetDeviceId, attempt + 1);
                }
                return false;
            }

            async function playSong(trackUri, setAutoFromHere = true, skipHistoryPush = false) {
                if (!isHost) return false;
                if (!activeDeviceId) { showToast('Still connecting to Spotify — try again in a moment'); return false; }

                if (!skipHistoryPush) {
                    const incoming = [...manualQueue, ...autoQueue, ...currentSongs].find(s => s.uri === trackUri)
                                  || (nowPlayingSong?.uri === trackUri ? nowPlayingSong : null);
                    if (incoming) {
                        if (historyStack[0]?.uri !== trackUri) {
                            historyStack.unshift({ ...incoming });
                            if (historyStack.length > 10) historyStack.pop();
                        }
                    }
                }

                appTriggeredUri = trackUri;

                console.log(`[playSong] PUT /play "${trackUri.slice(-6)}" | setAutoFromHere=${setAutoFromHere}`);
                console.log(`[playSong] queue — manual:[${manualQueue.map(s=>s.name).join(', ')||'empty'}] auto:[${autoQueue.slice(0,3).map(s=>s.name).join(', ')||'empty'}...]`);

                // On the very first play the browser hasn't activated the audio context yet.
                // Calling resume() here (inside a user-gesture call chain) warms it up so
                // the subsequent /spotify/play doesn't land on a paused SDK.
                if (!hasPlayedOnce && player && activeDeviceId === deviceId) {
                    hasPlayedOnce = true;
                    try { await player.resume(); } catch (e) { /* ignore — not yet playing */ }
                }

                const ok = await sendPlayRequest(trackUri, activeDeviceId);
                if (!ok) {
                    showToast('Playback failed to start — try again');
                    return false;
                }

                if (nowPlayingSong?.uri !== trackUri) {
                    const known = [...manualQueue, ...autoQueue, ...currentSongs].find(s => s.uri === trackUri);
                    if (known) { nowPlayingSong = known; renderQueue(); }
                }
                if (setAutoFromHere) {
                    const idx   = currentSongs.findIndex(s => s.uri === trackUri);
                    const after = idx >= 0 ? currentSongs.slice(idx + 1) : currentSongs;
                    const slice = after.slice(0, 30);
                    const ordered = shuffleEnabled ? fisherYates(slice) : slice;
                    socket.emit('queue-set-auto', { roomId, songs: ordered });
                }
                return true;
            }



            function queueSong(song) {
                socket.emit('queue-add', { roomId, song });
                showToast(`"${song.name}" added to queue`);
            }

            async function fetchMoreSongs() {
                try {
                    const res   = await fetch(`/spotify/liked?offset=${autoQueueOffset}&limit=50`);
                    if (!res.ok) return;
                    const songs = await res.json();
                    if (songs.length > 0) {
                        autoQueueOffset += songs.length;
                        const batch = shuffleEnabled ? fisherYates(songs.slice(0, 30)) : songs.slice(0, 30);
                        socket.emit('queue-replenish', { roomId, songs: batch });
                    }
                } catch (e) {}
            }

            // ── Library sidebar (Spotify users only) ─────────────────────────────────
            <% if (user) { %>

            const sidebar   = document.getElementById('library-sidebar');
            const libToggle = document.getElementById('btn-library-toggle');
            const backdrop  = document.getElementById('sidebar-backdrop');

            function openSidebar() {
                sidebar.classList.remove('collapsed');
