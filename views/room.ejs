            }

            // ── Play a track ──────────────────────────────────────────────────────────
            async function playSong(trackUri, setAutoFromHere = true, skipHistoryPush = false) {
                if (!isHost) return;
                if (!activeDeviceId) return alert('Player not ready yet');
                // console.log(`[player] playSong "${trackUri}" setAutoFromHere=${setAutoFromHere}`);

                // Push the INCOMING song to history immediately when it starts playing,
                // so back button always has an accurate recent-play list regardless of
                // whether the previous song finished naturally or was manually skipped.
                if (!skipHistoryPush) {
                    // Find the song object for trackUri so we have name/artist/image
                    const incoming = [...manualQueue, ...autoQueue, ...currentSongs].find(s => s.uri === trackUri)
                                  || (nowPlayingSong?.uri === trackUri ? nowPlayingSong : null);
                    if (incoming) {
                        // Only push if it's not already the most recent history entry
                        if (historyStack[0]?.uri !== trackUri) {
                            historyStack.unshift({ ...incoming });
                            if (historyStack.length > 10) historyStack.pop();
                            // console.log(`[history] pushed "${incoming.name}" — stack: [${historyStack.map(s => s.name).join(', ')}]`);
                        }
                    }
                }

                // Mark this URI as app-triggered so polling/SDK don't double-advance
                appTriggeredUri = trackUri;

                console.log(`[playSong] PUT /play "${trackUri.slice(-6)}" | setAutoFromHere=${setAutoFromHere}`);
                console.log(`[playSong] queue — manual:[${manualQueue.map(s=>s.name).join(', ')||'empty'}] auto:[${autoQueue.slice(0,3).map(s=>s.name).join(', ')||'empty'}...]`);

                await fetch('/spotify/play', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ trackUri, deviceId: activeDeviceId }),
                });
                if (nowPlayingSong?.uri !== trackUri) {
                    const known = [...manualQueue, ...autoQueue, ...currentSongs].find(s => s.uri === trackUri);
                    if (known) { nowPlayingSong = known; renderQueue(); }
                }
                if (setAutoFromHere) {
                    const idx   = currentSongs.findIndex(s => s.uri === trackUri);
                    const after = idx >= 0 ? currentSongs.slice(idx + 1) : currentSongs;
                    socket.emit('queue-set-auto', { roomId, songs: after.slice(0, 30) });
                }
            }



            function queueSong(song) {
                socket.emit('queue-add', { roomId, song });
                showToast(`"${song.name}" added to queue`);
            }

