<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Jamsesh — Room</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #0a0a0a;
            --surface: #111111;
            --surface2: #1a1a1a;
            --surface3: #202020;
            --border: #222222;
            --green: #1db954;
            --green-dim: #1aa34a;
            --text: #f0f0f0;
            --muted: #555;
            --muted2: #888;
            --player-h: 88px;
            --drawer-w: 340px;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Mono', monospace;
            min-height: 100vh;
            padding-bottom: calc(var(--player-h) + 24px);
            overflow-x: hidden;
        }

        /* ── Header ── */
        header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 20px 32px; border-bottom: 1px solid var(--border);
            position: sticky; top: 0;
            background: rgba(10,10,10,0.92); backdrop-filter: blur(12px); z-index: 10;
        }

        .header-left { display: flex; align-items: center; gap: 16px; }

        .logo {
            font-family: 'Syne', sans-serif; font-weight: 800;
            font-size: 1.3rem; letter-spacing: -0.03em; color: var(--green);
            text-decoration: none;
        }

        .room-id-pill {
            display: flex; align-items: center; gap: 8px;
            background: var(--surface2); border: 1px solid var(--border);
            border-radius: 100px; padding: 4px 12px 4px 8px;
            font-size: 0.72rem; color: var(--muted2); cursor: pointer;
            transition: border-color 0.2s;
        }

        .room-id-pill:hover { border-color: var(--green); color: var(--text); }

        .room-id-pill svg { color: var(--muted); flex-shrink: 0; }

        .host-badge {
            background: rgba(29,185,84,0.12); border: 1px solid rgba(29,185,84,0.3);
            color: var(--green); border-radius: 100px;
            font-size: 0.65rem; letter-spacing: 0.06em; padding: 3px 10px;
        }

        .header-right { display: flex; align-items: center; gap: 12px; }

        .user-pill {
            display: flex; align-items: center; gap: 8px;
            background: var(--surface2); border: 1px solid var(--border);
            border-radius: 100px; padding: 5px 14px 5px 5px;
        }

        .user-pill img, .avatar-placeholder {
            width: 26px; height: 26px; border-radius: 50%;
        }

        .user-pill img { object-fit: cover; }

        .avatar-placeholder {
            background: var(--green); display: flex; align-items: center;
            justify-content: center; font-size: 0.65rem; font-weight: 700; color: #000;
        }

        .user-pill span { font-size: 0.75rem; color: var(--muted2); }

        .btn-text {
            background: none; border: none; color: var(--muted); cursor: pointer;
            font-family: 'DM Mono', monospace; font-size: 0.72rem;
            letter-spacing: 0.04em; transition: color 0.2s; text-decoration: none;
        }

        .btn-text:hover { color: var(--text); }

        /* ── Main layout ── */
        main {
            max-width: 900px; margin: 0 auto; padding: 40px 24px 0;
            transition: margin-right 0.3s ease;
        }

        body.drawer-open main { margin-right: var(--drawer-w); }

        /* ── Room info bar ── */
        .room-info {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 28px; gap: 16px;
        }

        .room-title {
            font-family: 'Syne', sans-serif; font-weight: 700;
            font-size: 1.4rem; letter-spacing: -0.02em;
        }

        .room-title span { color: var(--muted2); font-weight: 400; font-size: 1rem; }

        .listener-count {
            display: flex; align-items: center; gap: 6px;
            font-size: 0.72rem; color: var(--muted2);
        }

        .listener-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: var(--green); animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50%       { opacity: 0.3; }
        }

        /* ── Tabs ── */
        .tabs {
            display: flex; gap: 0; margin-bottom: 24px;
            border-bottom: 1px solid var(--border);
        }

        .tab-btn {
            background: none; border: none; color: var(--muted);
            font-family: 'DM Mono', monospace; font-size: 0.8rem;
            padding: 10px 20px; cursor: pointer; border-bottom: 2px solid transparent;
            margin-bottom: -1px; transition: color 0.2s, border-color 0.2s;
            letter-spacing: 0.03em;
        }

        .tab-btn.active { color: var(--text); border-bottom-color: var(--green); }
        .tab-btn:hover:not(.active) { color: var(--muted2); }

        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        /* ── Search ── */
        .search-wrap { position: relative; display: flex; align-items: center; margin-bottom: 20px; }

        .search-wrap svg { position: absolute; left: 10px; color: var(--muted); pointer-events: none; }

        .search-input {
            background: var(--surface2); border: 1px solid var(--border);
            border-radius: 8px; color: var(--text); font-family: 'DM Mono', monospace;
            font-size: 0.78rem; padding: 8px 12px 8px 32px; outline: none;
            width: 100%; transition: border-color 0.2s;
        }

        .search-input::placeholder { color: var(--muted); }
        .search-input:focus { border-color: var(--green); }

        /* ── Song List ── */
        .song-list { display: flex; flex-direction: column; gap: 2px; }

        .song-row {
            display: grid;
            grid-template-columns: 32px 44px 1fr auto;
            align-items: center; gap: 14px; padding: 9px 14px;
            border-radius: 8px; border: 1px solid transparent;
            transition: background 0.15s; animation: fadeUp 0.35s ease both;
        }

        .song-row:hover { background: var(--surface2); border-color: var(--border); }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .song-index { font-size: 0.72rem; color: var(--muted); text-align: center; }

        .song-art { width: 44px; height: 44px; border-radius: 4px; object-fit: cover; }

        .song-art-placeholder {
            width: 44px; height: 44px; border-radius: 4px;
            background: var(--surface2); border: 1px solid var(--border);
        }

        .song-info { overflow: hidden; }

        .song-name {
            font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.85rem;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        .song-artist {
            font-size: 0.72rem; color: var(--muted2); margin-top: 2px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        .row-actions { display: flex; gap: 6px; opacity: 0; transition: opacity 0.15s; }
        .song-row:hover .row-actions { opacity: 1; }

        .btn-play, .btn-queue {
            border: none; border-radius: 6px; cursor: pointer;
            font-family: 'DM Mono', monospace; font-size: 0.65rem;
            padding: 5px 8px; transition: background 0.15s, transform 0.1s; white-space: nowrap;
        }

        .btn-play { background: var(--green); color: #000; font-weight: 600; }
        .btn-play:hover { background: var(--green-dim); transform: scale(1.05); }
        .btn-queue { background: var(--surface); color: var(--muted2); border: 1px solid var(--border); }
        .btn-queue:hover { color: var(--text); border-color: var(--muted2); }

        /* Host-only play button */
        .btn-play.host-only { display: none; }

        .match { color: var(--green); }

        .no-results { text-align: center; padding: 48px 0; color: var(--muted); font-size: 0.8rem; display: none; }

        /* ── Import panel ── */
        .import-section {
            display: flex; flex-direction: column; gap: 16px; padding: 8px 0;
        }

        .import-label {
            font-size: 0.72rem; color: var(--muted); letter-spacing: 0.08em;
            text-transform: uppercase; margin-bottom: 4px;
        }

        .import-row { display: flex; gap: 10px; }

        .import-input {
            flex: 1; background: var(--surface2); border: 1px solid var(--border);
            border-radius: 8px; color: var(--text); font-family: 'DM Mono', monospace;
            font-size: 0.78rem; padding: 9px 14px; outline: none;
            transition: border-color 0.2s;
        }

        .import-input::placeholder { color: var(--muted); }
        .import-input:focus { border-color: var(--green); }

        .btn-import {
            background: var(--green); color: #000; border: none; border-radius: 8px;
            font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.78rem;
            padding: 9px 18px; cursor: pointer; transition: background 0.2s, transform 0.1s;
            white-space: nowrap;
        }

        .btn-import:hover { background: var(--green-dim); transform: scale(1.02); }
        .btn-import:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

        .import-note {
            font-size: 0.7rem; color: var(--muted); line-height: 1.6;
        }

        /* ── Player Bar ── */
        #player-bar {
            position: fixed; bottom: 0; left: 0; right: 0;
            height: var(--player-h);
            background: rgba(15,15,15,0.97); border-top: 1px solid var(--border);
            backdrop-filter: blur(16px);
            display: flex; align-items: center;
            padding: 0 28px; gap: 20px; z-index: 100;
            transition: right 0.3s ease;
        }

        body.drawer-open #player-bar { right: var(--drawer-w); }

        .now-playing {
            display: flex; align-items: center; gap: 12px;
            width: 220px; min-width: 0;
        }

        #np-art {
            width: 48px; height: 48px; border-radius: 4px;
            object-fit: cover; background: var(--surface2); flex-shrink: 0;
        }

        .np-text { overflow: hidden; }

        #np-name {
            font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.85rem;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        #np-artist {
            font-size: 0.7rem; color: var(--muted2); margin-top: 2px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        .player-controls {
            flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px;
        }

        .control-btns { display: flex; align-items: center; gap: 18px; }

        .ctrl-btn {
            background: none; border: none; color: var(--muted2);
            cursor: pointer; padding: 4px; transition: color 0.15s, transform 0.1s;
            display: flex; align-items: center;
        }

        .ctrl-btn:hover { color: var(--text); transform: scale(1.1); }
        .ctrl-btn:disabled { opacity: 0.25; cursor: not-allowed; transform: none; }

        #btn-play-pause {
            width: 36px; height: 36px; border-radius: 50%;
            background: var(--text); color: #000;
            display: flex; align-items: center; justify-content: center;
            transition: background 0.15s, transform 0.1s;
        }

        #btn-play-pause:hover { background: var(--green); transform: scale(1.08); }

        .progress-wrap {
            display: flex; align-items: center; gap: 10px;
            width: 100%; max-width: 480px;
        }

        .time-label { font-size: 0.65rem; color: var(--muted); width: 32px; }
        .time-label.right { text-align: right; }

        #progress-bar {
            flex: 1; height: 4px; background: var(--surface2);
            border-radius: 2px; cursor: pointer; position: relative;
        }

        #progress-fill {
            height: 100%; background: var(--green); border-radius: 2px;
            width: 0%; transition: width 0.5s linear; pointer-events: none;
        }

        .volume-wrap { display: flex; align-items: center; gap: 8px; width: 120px; }
        .volume-wrap svg { color: var(--muted2); flex-shrink: 0; }

        #volume-slider {
            -webkit-appearance: none; appearance: none;
            flex: 1; height: 4px; background: var(--surface2);
            border-radius: 2px; outline: none; cursor: pointer;
        }

        #volume-slider::-webkit-slider-thumb {
            -webkit-appearance: none; width: 12px; height: 12px;
            border-radius: 50%; background: var(--text); cursor: pointer;
        }

        /* Guest bar (non-host) */
        #guest-bar {
            position: fixed; bottom: 0; left: 0; right: 0;
            height: 64px;
            background: rgba(15,15,15,0.97); border-top: 1px solid var(--border);
            backdrop-filter: blur(16px);
            display: flex; align-items: center; justify-content: center;
            gap: 16px; z-index: 100;
            transition: right 0.3s ease;
        }

        body.drawer-open #guest-bar { right: var(--drawer-w); }

        #guest-np {
            font-size: 0.78rem; color: var(--muted2);
            display: flex; align-items: center; gap: 10px;
        }

        #guest-np-art {
            width: 36px; height: 36px; border-radius: 3px;
            object-fit: cover; background: var(--surface2); opacity: 0;
        }

        #guest-np-text { font-size: 0.75rem; color: var(--muted2); }
        #guest-np-name { color: var(--text); font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.82rem; }

        /* Queue toggle */
        #btn-queue-toggle {
            background: none; border: 1px solid var(--border);
            border-radius: 8px; color: var(--muted2); cursor: pointer;
            padding: 7px 10px; transition: all 0.2s;
            display: flex; align-items: center; gap: 6px;
            font-family: 'DM Mono', monospace; font-size: 0.7rem; flex-shrink: 0;
        }

        #btn-queue-toggle:hover, #btn-queue-toggle.active {
            color: var(--green); border-color: var(--green);
        }

        #queue-badge {
            background: var(--green); color: #000; border-radius: 100px;
            font-size: 0.6rem; font-weight: 700; padding: 1px 6px; display: none;
        }

        #queue-badge.visible { display: inline; }

        #sdk-status {
            font-size: 0.65rem; color: var(--muted); white-space: nowrap;
        }

        #sdk-status.ready { color: var(--green); }
        #sdk-status.error { color: #e74c3c; }

        /* ── Queue Drawer ── */
        #queue-drawer {
            position: fixed; top: 0; right: calc(-1 * var(--drawer-w));
            width: var(--drawer-w); height: 100vh;
            background: var(--surface); border-left: 1px solid var(--border);
            z-index: 90; display: flex; flex-direction: column;
            transition: right 0.3s ease;
            padding-bottom: var(--player-h);
        }

        #queue-drawer.open { right: 0; }

        .drawer-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 20px 20px 16px; border-bottom: 1px solid var(--border); flex-shrink: 0;
        }

        .drawer-header h2 {
            font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1rem;
        }

        .drawer-close {
            background: none; border: none; color: var(--muted); cursor: pointer;
            padding: 4px; transition: color 0.2s; display: flex; align-items: center;
        }

        .drawer-close:hover { color: var(--text); }

        .drawer-body { flex: 1; overflow-y: auto; padding: 12px 0; }

        .drawer-body::-webkit-scrollbar { width: 4px; }
        .drawer-body::-webkit-scrollbar-track { background: transparent; }
        .drawer-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        .queue-section-label {
            font-size: 0.65rem; color: var(--muted); letter-spacing: 0.1em;
            padding: 8px 20px 4px; text-transform: uppercase;
        }

        .queue-item {
            display: grid; grid-template-columns: 24px 40px 1fr 28px;
            align-items: center; gap: 10px; padding: 8px 16px;
            cursor: grab; border: 1px solid transparent; border-radius: 6px;
            margin: 1px 8px; transition: background 0.15s; touch-action: none;
        }

        .queue-item:hover { background: var(--surface2); border-color: var(--border); }
        .queue-item.dragging { opacity: 0.4; }
        .queue-item.drag-over { border-color: var(--green); background: rgba(29,185,84,0.06); }

        .drag-handle { color: var(--muted); display: flex; align-items: center; justify-content: center; }

        .queue-art { width: 40px; height: 40px; border-radius: 3px; object-fit: cover; background: var(--surface2); }
        .queue-art-placeholder { width: 40px; height: 40px; border-radius: 3px; background: var(--surface2); border: 1px solid var(--border); }

        .queue-info { overflow: hidden; }

        .queue-name {
            font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.78rem;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        .queue-artist {
            font-size: 0.68rem; color: var(--muted2); margin-top: 1px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        .queue-remove {
            background: none; border: none; color: var(--muted); cursor: pointer;
            padding: 4px; opacity: 0; transition: opacity 0.15s, color 0.15s;
            display: flex; align-items: center;
        }

        .queue-item:hover .queue-remove { opacity: 1; }
        .queue-remove:hover { color: #e74c3c; }

        .queue-empty {
            text-align: center; padding: 32px 16px;
            color: var(--muted); font-size: 0.75rem; line-height: 1.8;
        }

        .queue-item.auto { opacity: 0.75; }
        .queue-item.auto:hover { opacity: 1; }
    </style>
</head>
<body>

<header>
    <div class="header-left">
        <a href="/spotify/dashboard" class="logo">jamsesh</a>
        <% if (isHost) { %>
            <span class="host-badge">HOST</span>
        <% } %>
        <!-- Room ID copy pill -->
        <div class="room-id-pill" id="copy-room-link" title="Copy invite link">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            <span id="room-id-label"><%= roomId.substring(0, 12) %>...</span>
        </div>
    </div>

    <div class="header-right">
        <div class="user-pill">
            <% if (user.avatar) { %>
                <img src="<%= user.avatar %>" alt="<%= user.displayName %>" />
            <% } else { %>
                <div class="avatar-placeholder"><%= user.displayName?.charAt(0).toUpperCase() %></div>
            <% } %>
            <span><%= user.displayName %></span>
        </div>
        <a href="/logout" class="btn-text">log out</a>
    </div>
</header>

<main id="main">
    <!-- Room title + listener count -->
    <div class="room-info">
        <div class="room-title">
            <% if (isHost) { %>
                Your room
            <% } else { %>
                Listening in <span>on <%= roomId %>'s room</span>
            <% } %>
        </div>
        <div class="listener-count">
            <div class="listener-dot"></div>
            <span id="listener-count">1 listener</span>
        </div>
    </div>

    <!-- Tabs: Liked Songs | Import Playlist -->
    <div class="tabs">
        <button class="tab-btn active" data-tab="liked">Liked Songs</button>
        <button class="tab-btn" data-tab="import">Import Playlist</button>
    </div>

    <!-- Liked Songs tab -->
    <div class="tab-panel active" id="tab-liked">
        <div class="search-wrap">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input class="search-input" id="search" type="text" placeholder="search songs..." autocomplete="off" />
        </div>
        <div class="song-list" id="song-list"></div>
        <div class="no-results" id="no-results">no matches found</div>
    </div>

    <!-- Import Playlist tab -->
    <div class="tab-panel" id="tab-import">
        <div class="import-section">
            <div>
                <div class="import-label">Apple Music playlist URL</div>
                <div class="import-row">
                    <input
                        class="import-input"
                        id="apple-url-input"
                        type="url"
                        placeholder="https://music.apple.com/us/playlist/..."
                    />
                    <button class="btn-import" id="btn-apple-import">Import</button>
                </div>
                <p class="import-note" style="margin-top:8px;">
                    Paste a public Apple Music playlist link. Songs will be matched to Spotify and added to your library here.
                </p>
            </div>

            <div style="border-top:1px solid var(--border); padding-top:16px;">
                <div class="import-label">Spotify playlist URL</div>
                <div class="import-row">
                    <input
                        class="import-input"
                        id="spotify-url-input"
                        type="url"
                        placeholder="https://open.spotify.com/playlist/..."
                    />
                    <button class="btn-import" id="btn-spotify-import">Import</button>
                </div>
                <p class="import-note" style="margin-top:8px;">
                    Paste a public Spotify playlist link to load those songs here.
                </p>
            </div>

            <!-- Imported songs render here -->
            <div id="imported-list"></div>
        </div>
    </div>
</main>

<!-- ── Queue Drawer ── -->
<div id="queue-drawer">
    <div class="drawer-header">
        <h2>Queue</h2>
        <button class="drawer-close" id="btn-drawer-close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
        </button>
    </div>
    <div class="drawer-body" id="drawer-body"></div>
</div>

<!-- ── Player Bar (host only) ── -->
<% if (isHost) { %>
<div id="player-bar">
    <div class="now-playing">
        <img id="np-art" src="" alt="" style="opacity:0;" />
        <div class="np-text">
            <div id="np-name" style="color:var(--muted);">Not playing</div>
            <div id="np-artist"></div>
        </div>
    </div>

    <div class="player-controls">
        <div class="control-btns">
            <button class="ctrl-btn" id="btn-prev">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/></svg>
            </button>
            <button class="ctrl-btn" id="btn-play-pause">
                <svg id="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                <svg id="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <button class="ctrl-btn" id="btn-next">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="m6 18 8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
            </button>
        </div>
        <div class="progress-wrap">
            <span class="time-label" id="time-current">0:00</span>
            <div id="progress-bar"><div id="progress-fill"></div></div>
            <span class="time-label right" id="time-total">0:00</span>
        </div>
    </div>

    <div class="volume-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>
        </svg>
        <input type="range" id="volume-slider" min="0" max="100" value="80" />
    </div>

    <span id="sdk-status">Connecting...</span>

    <button id="btn-queue-toggle">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>
        </svg>
        Queue <span id="queue-badge">0</span>
    </button>
</div>
<% } %>

<!-- ── Guest Bar (non-host) ── -->
<% if (!isHost) { %>
<div id="guest-bar">
    <div id="guest-np">
        <img id="guest-np-art" src="" alt="" />
        <div id="guest-np-text">
            <div id="guest-np-name">Waiting for host to play...</div>
        </div>
    </div>

    <button id="btn-queue-toggle">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>
        </svg>
        Queue <span id="queue-badge">0</span>
    </button>
</div>
<% } %>

<!-- Spotify SDK (host only) -->
<% if (isHost) { %>
<script src="https://sdk.scdn.co/spotify-player.js"></script>
<% } %>

<!-- Socket.io -->
<script src="/socket.io/socket.io.js"></script>

<script>
    // ── Server data ───────────────────────────────────────────────────────────
    const allSongs = <%- JSON.stringify(songs || []) %>;
    const userId   = '<%= user.id %>';
    const roomId   = '<%= roomId %>';
    const isHost   = <%= isHost %>;

    // ── State ─────────────────────────────────────────────────────────────────
    let deviceId        = null;
    let player          = null;
    let currentTrackUri = null;
    let isPlaying       = false;
    let progressInterval = null;
    let currentPosition  = 0;
    let currentDuration  = 0;
    let manualQueue      = [];
    let autoQueue        = [];
    let listenerCount    = 1;

    // ── Socket.io ─────────────────────────────────────────────────────────────
    const socket = io();
    socket.emit('join-room', roomId);

    socket.on('queue-state', ({ manualQueue: mq, autoQueue: aq }) => {
        manualQueue = mq || [];
        autoQueue   = aq || [];
        renderQueue();
    });

    socket.on('play-track', (song) => {
        if (isHost) playSong(song.uri, false);
        else updateGuestNowPlaying(song);
    });

    // Broadcast now-playing to guests when track changes
    socket.on('now-playing', (song) => {
        if (!isHost) updateGuestNowPlaying(song);
    });

    socket.on('listener-update', (count) => {
        listenerCount = count;
        const el = document.getElementById('listener-count');
        if (el) el.textContent = `${count} listener${count !== 1 ? 's' : ''}`;
    });

    // ── Copy invite link ──────────────────────────────────────────────────────
    document.getElementById('copy-room-link').addEventListener('click', () => {
        const url = `${window.location.origin}/rooms/${roomId}`;
        navigator.clipboard.writeText(url).then(() => showToast('Invite link copied!'));
    });

    // ── Tabs ──────────────────────────────────────────────────────────────────
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById(`tab-${btn.dataset.tab}`).classList.add('active');
        });
    });

    // ── Spotify Web Playback SDK (host only) ──────────────────────────────────
    <% if (isHost) { %>
    window.onSpotifyWebPlaybackSDKReady = async () => {
        player = new Spotify.Player({
            name: 'Jamsesh Player',
            getOAuthToken: async (cb) => {
                const data = await fetch('/spotify/token').then(r => r.json());
                cb(data.accessToken);
            },
            volume: 0.8,
        });

        player.addListener('ready', ({ device_id }) => {
            deviceId = device_id;
            setStatus('ready', '● Ready');
        });

        player.addListener('not_ready', () => setStatus('error', '✕ Disconnected'));

        player.addListener('player_state_changed', (state) => {
            if (!state) return;
            const track = state.track_window.current_track;
            isPlaying       = !state.paused;
            currentPosition = state.position;
            currentDuration = state.duration;

            updateNowPlaying(track);
            updatePlayPauseIcon();
            updateProgress();

            // Broadcast now-playing to guests
            socket.emit('now-playing-broadcast', {
                roomId,
                song: {
                    name: track.name,
                    artist: track.artists.map(a => a.name).join(', '),
                    image: track.album?.images?.[0]?.url || '',
                    uri: track.uri,
                }
            });

            clearInterval(progressInterval);
            if (isPlaying) {
                progressInterval = setInterval(() => {
                    currentPosition += 500;
                    updateProgress();
                    // Near end of track — advance queue
                    if (currentDuration > 0 && currentPosition >= currentDuration - 2000) {
                        clearInterval(progressInterval);
                        socket.emit('queue-advance', { roomId });
                    }
                }, 500);
            }

            // Refill auto queue when low
            if (autoQueue.length <= 10) refillAutoQueue();
        });

        player.addListener('initialization_error', ({ message }) => setStatus('error', `Init: ${message}`));
        player.addListener('authentication_error', ({ message }) => setStatus('error', `Auth: ${message}`));
        player.addListener('account_error', () => setStatus('error', 'Premium required'));

        player.connect();
    };

    // Player controls
    document.getElementById('btn-play-pause').addEventListener('click', () => player?.togglePlay());
    document.getElementById('btn-prev').addEventListener('click', () => player?.previousTrack());
    document.getElementById('btn-next').addEventListener('click', () => socket.emit('queue-advance', { roomId }));

    document.getElementById('volume-slider').addEventListener('input', (e) => {
        player?.setVolume(e.target.value / 100);
    });

    document.getElementById('progress-bar').addEventListener('click', (e) => {
        if (!player || !currentDuration) return;
        const rect   = e.currentTarget.getBoundingClientRect();
        const seekTo = Math.floor(((e.clientX - rect.left) / rect.width) * currentDuration);
        player.seek(seekTo);
        currentPosition = seekTo;
        updateProgress();
    });

    function setStatus(type, msg) {
        const el = document.getElementById('sdk-status');
        el.textContent = msg; el.className = type;
    }

    function updateNowPlaying(track) {
        const img = track.album?.images?.[0]?.url || '';
        const art = document.getElementById('np-art');
        art.src = img; art.style.opacity = img ? '1' : '0';
        document.getElementById('np-name').textContent   = track.name;
        document.getElementById('np-name').style.color   = '';
        document.getElementById('np-artist').textContent = track.artists.map(a => a.name).join(', ');
        currentTrackUri = track.uri;
    }

    function updatePlayPauseIcon() {
        document.getElementById('icon-play').style.display  = isPlaying ? 'none'  : 'block';
        document.getElementById('icon-pause').style.display = isPlaying ? 'block' : 'none';
    }

    function updateProgress() {
        const pct = currentDuration ? (currentPosition / currentDuration) * 100 : 0;
        document.getElementById('progress-fill').style.width = `${pct}%`;
        document.getElementById('time-current').textContent  = msToTime(currentPosition);
        document.getElementById('time-total').textContent    = msToTime(currentDuration);
    }
    <% } %>

    // ── Guest now-playing ─────────────────────────────────────────────────────
    function updateGuestNowPlaying(song) {
        const art  = document.getElementById('guest-np-art');
        const name = document.getElementById('guest-np-name');
        if (!art || !name) return;
        if (song.image) { art.src = song.image; art.style.opacity = '1'; }
        name.textContent = `${song.name} — ${song.artist}`;
    }

    // ── Play a track ──────────────────────────────────────────────────────────
    async function playSong(trackUri, loadPlaylist) {
        if (!isHost) return;
        if (!deviceId) return alert('Player not ready yet');
        await fetch('/spotify/play', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ trackUri, deviceId }),
        });
        currentTrackUri = trackUri;
        if (loadPlaylist) {
            const startIdx = allSongs.findIndex(s => s.uri === trackUri);
            const rest = allSongs.slice(startIdx + 1, startIdx + 31);
            socket.emit('queue-set-auto', { roomId, songs: rest });
        }
    }

    // ── Queue a song ──────────────────────────────────────────────────────────
    function queueSong(song) {
        socket.emit('queue-add', { roomId, song });
        showToast(`"${song.name}" added to queue`);
    }

    // ── Auto queue refill ─────────────────────────────────────────────────────
    function refillAutoQueue() {
        const inQueue = new Set(autoQueue.map(s => s.uri));
        const needed  = allSongs.filter(s => !inQueue.has(s.uri)).slice(0, 30);
        if (needed.length > 0) socket.emit('queue-replenish', { roomId, songs: needed });
    }

    // ── Queue Drawer ──────────────────────────────────────────────────────────
    const drawer      = document.getElementById('queue-drawer');
    const queueToggle = document.getElementById('btn-queue-toggle');

    function toggleDrawer(open) {
        drawer.classList.toggle('open', open);
        document.body.classList.toggle('drawer-open', open);
        queueToggle.classList.toggle('active', open);
    }

    queueToggle.addEventListener('click', () => toggleDrawer(!drawer.classList.contains('open')));
    document.getElementById('btn-drawer-close').addEventListener('click', () => toggleDrawer(false));

    function renderQueue() {
        const body  = document.getElementById('drawer-body');
        const badge = document.getElementById('queue-badge');
        const total = manualQueue.length + autoQueue.length;

        badge.textContent = total;
        badge.classList.toggle('visible', total > 0);

        body.innerHTML = '';

        if (total === 0) {
            body.innerHTML = `<div class="queue-empty">Queue is empty.<br/>Add songs with <strong>+ queue</strong>.</div>`;
            return;
        }

        if (manualQueue.length > 0) {
            body.appendChild(label('Up next'));
            manualQueue.forEach((song, i) => body.appendChild(buildQueueItem(song, i, 'manual')));
        }

        if (autoQueue.length > 0) {
            body.appendChild(label('From liked songs'));
            autoQueue.forEach((song, i) => body.appendChild(buildQueueItem(song, i, 'auto')));
        }
    }

    function label(text) {
        const el = document.createElement('div');
        el.className = 'queue-section-label';
        el.textContent = text;
        return el;
    }

    function buildQueueItem(song, index, queueType) {
        const item = document.createElement('div');
        item.className = `queue-item${queueType === 'auto' ? ' auto' : ''}`;
        item.dataset.index     = index;
        item.dataset.queueType = queueType;
        item.draggable         = true;

        item.innerHTML = `
            <div class="drag-handle">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" opacity="0.5">
                    <path d="M3 15h18v-2H3v2zm0 4h18v-2H3v2zm0-8h18V9H3v2zm0-6v2h18V5H3z"/>
                </svg>
            </div>
            ${song.image
                ? `<img class="queue-art" src="${song.image}" alt="${song.name}" />`
                : `<div class="queue-art-placeholder"></div>`}
            <div class="queue-info">
                <div class="queue-name">${song.name}</div>
                <div class="queue-artist">${song.artist}</div>
            </div>
            <button class="queue-remove" title="Remove">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6 6 18M6 6l12 12"/>
                </svg>
            </button>
        `;

        item.querySelector('.queue-remove').addEventListener('click', (e) => {
            e.stopPropagation();
            socket.emit('queue-remove', { roomId, queueType, index });
        });

        // Desktop drag
        item.addEventListener('dragstart', (e) => {
            e.dataTransfer.setData('text/plain', JSON.stringify({ index, queueType }));
            setTimeout(() => item.classList.add('dragging'), 0);
        });
        item.addEventListener('dragend', () => item.classList.remove('dragging'));
        item.addEventListener('dragover', (e) => { e.preventDefault(); item.classList.add('drag-over'); });
        item.addEventListener('dragleave', () => item.classList.remove('drag-over'));
        item.addEventListener('drop', (e) => {
            e.preventDefault();
            item.classList.remove('drag-over');
            const { index: from, queueType: fromType } = JSON.parse(e.dataTransfer.getData('text/plain'));
            const to = parseInt(item.dataset.index);
            if (fromType === item.dataset.queueType && from !== to) {
                socket.emit('queue-reorder', { roomId, queueType: fromType, fromIndex: from, toIndex: to });
            }
        });

        // Mobile touch drag
        let touchStartY = 0;
        item.addEventListener('touchstart', (e) => { touchStartY = e.touches[0].clientY; }, { passive: true });
        item.addEventListener('touchend', (e) => {
            const delta = e.changedTouches[0].clientY - touchStartY;
            const steps = Math.round(delta / (item.offsetHeight + 2));
            if (steps !== 0) {
                socket.emit('queue-reorder', {
                    roomId, queueType,
                    fromIndex: index,
                    toIndex: Math.max(0, index + steps)
                });
            }
        }, { passive: true });

        return item;
    }

    // ── Song list render ──────────────────────────────────────────────────────
    function fuzzyScore(str, query) {
        str = str.toLowerCase(); query = query.toLowerCase();
        if (str.startsWith(query)) return 0;
        if (str.includes(query)) return 1;
        let qi = 0, gaps = 0, last = -1;
        for (let i = 0; i < str.length && qi < query.length; i++) {
            if (str[i] === query[qi]) { gaps += last >= 0 ? i - last - 1 : 0; last = i; qi++; }
        }
        return qi < query.length ? Infinity : 2 + gaps;
    }

    function highlight(str, query) {
        if (!query) return str;
        const idx = str.toLowerCase().indexOf(query.toLowerCase());
        if (idx !== -1) return str.slice(0, idx) + `<span class="match">${str.slice(idx, idx + query.length)}</span>` + str.slice(idx + query.length);
        let r = '', qi = 0;
        for (const ch of str) {
            if (qi < query.length && ch.toLowerCase() === query[qi].toLowerCase()) { r += `<span class="match">${ch}</span>`; qi++; }
            else r += ch;
        }
        return r;
    }

    function renderSongs(filtered, query = '') {
        const list = document.getElementById('song-list');
        const noResults = document.getElementById('no-results');
        list.innerHTML = '';

        if (filtered.length === 0) { noResults.style.display = 'block'; return; }
        noResults.style.display = 'none';

        filtered.forEach((song, i) => {
            const row = document.createElement('div');
            row.className = 'song-row';
            row.innerHTML = `
                <span class="song-index">${i + 1}</span>
                ${song.image ? `<img class="song-art" src="${song.image}" alt="" />` : `<div class="song-art-placeholder"></div>`}
                <div class="song-info">
                    <div class="song-name">${highlight(song.name, query)}</div>
                    <div class="song-artist">${highlight(song.artist, query)}</div>
                </div>
                <div class="row-actions">
                    ${isHost ? `<button class="btn-play">▶ play</button>` : ''}
                    <button class="btn-queue">+ queue</button>
                </div>
            `;
            if (isHost) row.querySelector('.btn-play').addEventListener('click', () => playSong(song.uri, true));
            row.querySelector('.btn-queue').addEventListener('click', () => queueSong(song));
            list.appendChild(row);
        });
    }

    renderSongs(allSongs);

    document.getElementById('search').addEventListener('input', (e) => {
        const q = e.target.value.trim();
        if (!q) { renderSongs(allSongs); return; }
        const scored = allSongs
            .map(s => ({ song: s, score: Math.min(fuzzyScore(s.name, q) * 0.5, fuzzyScore(s.artist, q)) }))
            .filter(s => s.score < Infinity).sort((a, b) => a.score - b.score);
        renderSongs(scored.map(s => s.song), q);
    });

    // ── Import placeholder handlers ───────────────────────────────────────────
    document.getElementById('btn-apple-import').addEventListener('click', () => {
        const url = document.getElementById('apple-url-input').value.trim();
        if (!url) return;
        showToast('Apple Music import coming soon!');
    });

    document.getElementById('btn-spotify-import').addEventListener('click', () => {
        const url = document.getElementById('spotify-url-input').value.trim();
        if (!url) return;
        showToast('Spotify playlist import coming soon!');
    });

    // ── Helpers ───────────────────────────────────────────────────────────────
    function msToTime(ms) {
        const s = Math.floor(ms / 1000);
        return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    }

    let toastTimeout;
    function showToast(msg) {
        let t = document.getElementById('toast');
        if (!t) {
            t = document.createElement('div');
            t.id = 'toast';
            t.style.cssText = `position:fixed;bottom:80px;left:50%;transform:translateX(-50%);
                background:var(--green);color:#000;font-family:'DM Mono',monospace;
                font-size:0.75rem;font-weight:600;padding:8px 18px;border-radius:100px;
                z-index:300;opacity:0;transition:opacity 0.2s;pointer-events:none;`;
            document.body.appendChild(t);
        }
        t.textContent   = msg;
        t.style.opacity = '1';
        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => { t.style.opacity = '0'; }, 2200);
    }
</script>
</body>
</html>
