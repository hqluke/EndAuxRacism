            document.getElementById('progress-bar').addEventListener('click', (e) => {
                if (!player || !currentDuration) return;
                const rect   = e.currentTarget.getBoundingClientRect();
                const seekTo = Math.floor(((e.clientX - rect.left) / rect.width) * currentDuration);
                player.seek(seekTo); currentPosition = seekTo; updateProgress();
            });

            // ── Spotify Connect: device picker + polling fallback ─────────────────────
            //
            // When the host transfers playback to another device (phone app, desktop,
            // etc.) and that device goes offline, the Web Playback SDK stops firing
            // player_state_changed, so queue advancement stalls. We fix this with a
            // polling fallback that watches GET /me/player every 3 s whenever the SDK
            // is not the active device.
            //
            // The Connect button opens a modal listing all active Spotify devices.
            // Selecting one calls PUT /me/player to transfer playback seamlessly.

            let pollingInterval    = null;
            let pollingLastUri     = null;
            let pollingLastPos     = 0;
            let sdkIsActiveDevice  = false; // true when SDK player is the active device
            let cachedPollingToken = null;  // reused across polls; cleared on 401

            function startPolling() {
                if (pollingInterval) return;
                console.log('[connect] starting playback polling (SDK not active device)');
                const pollingStatusEl = document.getElementById('connect-polling-status');
                if (pollingStatusEl) pollingStatusEl.textContent = '⚡ Polling mode';
                pollingInterval = setInterval(pollPlaybackState, 3000);
            }

            function stopPolling() {
                if (!pollingInterval) return;
                console.log('[connect] stopping playback polling (SDK reclaimed device)');
                const pollingStatusEl = document.getElementById('connect-polling-status');
                if (pollingStatusEl) pollingStatusEl.textContent = '';
                clearInterval(pollingInterval);
                pollingInterval = null;
            }

            async function pollPlaybackState() {
                // If the SDK has reclaimed the device, stop polling
                if (sdkIsActiveDevice) { stopPolling(); return; }
                try {
                    // Reuse cached token — only re-fetch if missing or last call returned 401
                    if (!cachedPollingToken) {
                        const res = await fetch('/spotify/token').then(r => r.json());
                        cachedPollingToken = res.accessToken;
                    }
                    if (!cachedPollingToken) return;

                    const stateRes = await fetch('https://api.spotify.com/v1/me/player', {
                        headers: { Authorization: `Bearer ${cachedPollingToken}` },
                    });

                    if (stateRes.status === 401) {
                        // Token expired — clear cache and retry next cycle
                        cachedPollingToken = null;
                        return;
                    }

                    // 204 = nothing playing; 200 = state available
                    if (stateRes.status === 204 || !stateRes.ok) return;

                    const state = await stateRes.json();
                    if (!state || !state.item) return;

                    const uri      = state.item.uri;
                    const pos      = state.progress_ms || 0;
                    const duration = state.item.duration_ms || 0;
                    const playing  = state.is_playing;

                    // Update progress bar even in polling mode
                    currentPosition = pos;
                    currentDuration = duration;
                    isPlaying       = playing;
                    updateProgress();
                    updatePlayPauseIcon();

                    // Update progress bar and broadcast now-playing if track changed.
                    // Queue advancement is handled server-side — no client queue-advance here.
                    if (uri !== pollingLastUri) {
                        pollingLastUri = uri;
                        const songData = {
                            name:   state.item.name,
                            artist: state.item.artists.map(a => a.name).join(', '),
                            image:  state.item.album?.images?.[0]?.url || '',
                            uri,
                        };
                        nowPlayingSong = songData;
                        updateNowPlaying(state.item);
                        renderQueue();
                        // Broadcast so server tracks now-playing and guests stay in sync
                        socket.emit('now-playing-broadcast', { roomId, song: songData });
                        console.log(`[poll] track changed: "${state.item.name}"`);
                    }
                } catch (e) {
                    console.warn('[connect] poll error:', e.message);
                }
            }

            const connectOverlay = document.getElementById('connect-modal-overlay');
