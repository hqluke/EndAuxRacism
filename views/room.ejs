                // ── Swipe left to close guest library sidebar (mobile) ────────────────
                (function initGuestSidebarSwipe() {
                    let swipeStartX = null;
                    let swipeStartY = null;
                    const SWIPE_H_THRESHOLD = 72;
                    const SWIPE_V_LOCK      = 12;

                    guestSidebar.addEventListener('touchstart', (e) => {
                        const btn = e.target.closest('button');
                        if (btn) { swipeStartX = null; return; }
                        const t = e.touches[0];
                        swipeStartX = t.clientX;
                        swipeStartY = t.clientY;
                        guestSidebar.style.transition = 'none';
                    }, { passive: true });

                    guestSidebar.addEventListener('touchmove', (e) => {
                        if (swipeStartX === null) return;
                        const t  = e.touches[0];
                        const dx = t.clientX - swipeStartX;
                        const dy = Math.abs(t.clientY - swipeStartY);
                        if (dy > SWIPE_V_LOCK && Math.abs(dx) < dy) { swipeStartX = null; guestSidebar.style.transform = ''; return; }
                        if (dx < 0) {
                            guestSidebar.style.transform = `translateX(${dx}px)`;
                        }
                    }, { passive: true });

                    guestSidebar.addEventListener('touchend', (e) => {
                        if (swipeStartX === null) return;
                        const dx = e.changedTouches[0].clientX - swipeStartX;
                        guestSidebar.style.transition = '';
                        guestSidebar.style.transform  = '';
                        if (dx < -SWIPE_H_THRESHOLD) closeGuestSidebar();
                        swipeStartX = null;
                    }, { passive: true });

                    guestSidebar.addEventListener('touchcancel', () => {
                        swipeStartX = null;
                        guestSidebar.style.transition = '';
                        guestSidebar.style.transform  = '';
                    }, { passive: true });
                })();
            }

