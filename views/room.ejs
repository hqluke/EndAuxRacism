            // ── Fuzzy search ──────────────────────────────────────────────────────────
            function fuzzyScore(str, query) {
                str = str.toLowerCase(); query = query.toLowerCase();
                if (str.startsWith(query)) return 0;
                if (str.includes(query))   return 1;
                let qi = 0, gaps = 0, last = -1;
                for (let i = 0; i < str.length && qi < query.length; i++) {
                    if (str[i] === query[qi]) { gaps += last >= 0 ? i - last - 1 : 0; last = i; qi++; }
                }
                return qi < query.length ? Infinity : 2 + gaps;
            }

            function highlight(str, query) {
                if (!query) return str;
                const idx = str.toLowerCase().indexOf(query.toLowerCase());
                if (idx !== -1) return str.slice(0, idx) + `<span class="match">${str.slice(idx, idx + query.length)}</span>` + str.slice(idx + query.length);
                let r = '', qi = 0;
                for (const ch of str) {
                    if (qi < query.length && ch.toLowerCase() === query[qi].toLowerCase()) { r += `<span class="match">${ch}</span>`; qi++; }
                    else r += ch;
                }
                return r;
            }

            // ── Song row builder ──────────────────────────────────────────────────────
            function makeSongRow(song, i) {
                const row   = document.createElement('div');
                row.className = 'song-row';
                const query = document.getElementById('search')?.value.trim() || '';
                row.innerHTML = `
                    <span class="song-index" style="${song.uri === currentTrackUri ? 'color:var(--green)' : ''}">${i + 1}</span>
                    ${song.image ? `<img class="song-art" src="${song.image}" alt="" />` : `<div class="song-art-placeholder"></div>`}
                    <div class="song-info">
                        <div class="song-name">${highlight(song.name, query)}</div>
                        <div class="song-artist">${highlight(song.artist, query)}</div>
                    </div>
                    <div class="row-actions">
                        ${isHost ? `<button class="btn-play">▶ play</button>` : ''}
                        <button class="btn-queue">+ queue</button>
                    </div>
                `;
                if (isHost) row.querySelector('.btn-play').addEventListener('click', async (e) => {
                    const btn = e.currentTarget;
                    btn.disabled = true;
                    try {
                        await playSong(song.uri, true);
                    } finally {
                        btn.disabled = false;
                    }
                });
                row.querySelector('.btn-queue').addEventListener('click', () => queueSong(song));
                return row;
            }

            // ── Render song list ──────────────────────────────────────────────────────
            function renderSongs(filtered) {
                const list      = document.getElementById('song-list');
                const noResults = document.getElementById('no-results');
                const countLabel = document.getElementById('count-label');
                const query     = document.getElementById('search')?.value.trim() || '';
                if (!list) return;
                list.innerHTML = '';

                if (filtered.length === 0) {
                    if (noResults) noResults.style.display = 'block';
                    if (countLabel) countLabel.textContent = 'NO RESULTS';
                    return;
                }

                if (noResults) noResults.style.display = 'none';
                if (countLabel) countLabel.textContent = query
                    ? `${filtered.length} RESULT${filtered.length !== 1 ? 'S' : ''}`
                    : `${filtered.length} SONGS`;

                filtered.forEach((song, i) => list.appendChild(makeSongRow(song, i)));

                if (currentSource === 'liked' && !query && !likedExhausted) {
                    attachScrollSentinel();
                }
            }

            // Initial render — controller pre-loads 50 songs server-side,
            // so render them immediately; likedOffset is already set to allSongs.length (50).
            <% if (user) { %>
            renderSongs(currentSongs);
            <% } %>

            // ── Queue render ──────────────────────────────────────────────────────────
            function renderQueue() {
                const body = document.getElementById('drawer-body');
                body.innerHTML = '';

                if (currentTrackUri && nowPlayingSong) {
                    const label = document.createElement('div');
                    label.className = 'queue-section-label';
                    label.textContent = 'Now Playing';
                    body.appendChild(label);
                    const row = document.createElement('div');
                    row.className = 'now-playing-row';
                    row.innerHTML = `
                        <div class="now-playing-dot"></div>
                        ${nowPlayingSong.image ? `<img class="q-art" src="${nowPlayingSong.image}" />` : `<div class="q-art-placeholder"></div>`}
                        <div class="q-info">
                            <div class="q-name">${nowPlayingSong.name || ''}</div>
                            <div class="q-artist">${nowPlayingSong.artist || ''}</div>
                        </div>`;
                    body.appendChild(row);
                }

                const manLabel = document.createElement('div');
                manLabel.className = 'queue-section-label';
                manLabel.textContent = `Manual Queue (${manualQueue.length})`;
                body.appendChild(manLabel);

                if (manualQueue.length === 0) {
                    const hint = document.createElement('div');
                    hint.className = 'queue-empty-hint';
                    hint.textContent = 'No queued songs — use + queue to add';
                    body.appendChild(hint);
                } else {
                    manualQueue.forEach((song, i) => body.appendChild(makeQueueItem(song, i, 'manual')));
                }

                const autoLabel = document.createElement('div');
                autoLabel.className = 'queue-section-label';
                autoLabel.style.marginTop = '12px';
                autoLabel.textContent = `Auto Queue (${autoQueue.length})`;
                body.appendChild(autoLabel);

                if (autoQueue.length === 0) {
                    const hint = document.createElement('div');
                    hint.className = 'queue-empty-hint';
                    hint.textContent = 'Will populate when you press play';
                    body.appendChild(hint);
                } else {
                    autoQueue.forEach((song, i) => body.appendChild(makeQueueItem(song, i, 'auto')));
                }
            }

            function makeQueueItem(song, index, queueType) {
                const item = document.createElement('div');
                item.className = 'queue-item';
                item.draggable = true;
                item.dataset.index     = index;
                item.dataset.queueType = queueType;
                item.innerHTML = `
                    <div class="drag-handle">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" opacity="0.4">
                            <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
                        </svg>
                    </div>
                    ${song.image ? `<img class="q-art" src="${song.image}" alt="" draggable="false" />` : `<div class="q-art-placeholder"></div>`}
                    <div class="q-info">
                        <div class="q-name">${song.name}</div>
                        <div class="q-artist">${song.artist}</div>
                    </div>
                    <button class="btn-remove-queue" title="Remove">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 6 6 18M6 6l12 12"/>
                        </svg>
                    </button>`;
                item.querySelector('.btn-remove-queue').addEventListener('click', (e) => {
                    e.stopPropagation();
                    socket.emit('queue-remove', { roomId, queueType: item.dataset.queueType, index: parseInt(item.dataset.index) });
                });
                return item;
            }

            // ── Drag & drop on queue drawer (mouse + touch) ───────────────────────────
            let dragSrc = null, dragOverItem = null;

            function reorderQueue(queueType, fromIndex, toIndex) {
                if (fromIndex === toIndex) return;
                const arr  = queueType === 'manual' ? manualQueue : autoQueue;
                const copy = [...arr];
                const [moved] = copy.splice(fromIndex, 1);
                copy.splice(toIndex, 0, moved);
                if (queueType === 'manual') manualQueue = copy; else autoQueue = copy;
                renderQueue();
                socket.emit('queue-reorder', { roomId, queueType, fromIndex, toIndex });
            }

            function moveToManualQueue(fromAutoIndex, toManualIndex) {
                const autoCopy   = [...autoQueue];
                const manualCopy = [...manualQueue];
                const [moved] = autoCopy.splice(fromAutoIndex, 1);
                const insertAt = manualCopy.length === 0 ? 0 : toManualIndex;
                manualCopy.splice(insertAt, 0, moved);
                autoQueue = autoCopy; manualQueue = manualCopy;
                renderQueue();
                socket.emit('queue-move-to-manual', { roomId, fromAutoIndex, toManualIndex: insertAt });
            }

            function commitDrop(dragSrcEl, targetEl) {
                if (!targetEl || !dragSrcEl || targetEl === dragSrcEl) return;
                document.querySelectorAll('.queue-item.drag-over').forEach(el => el.classList.remove('drag-over'));
                const fromIndex = parseInt(dragSrcEl.dataset.index);
                const fromType  = dragSrcEl.dataset.queueType;
                const toIndex   = parseInt(targetEl.dataset.index);
                const toType    = targetEl.dataset.queueType;
                if (fromType !== toType) {
                    if (fromType === 'auto' && toType === 'manual') moveToManualQueue(fromIndex, toIndex);
                    return;
                }
                reorderQueue(fromType, fromIndex, toIndex);
            }

            (function initDrag() {
                const body = document.getElementById('drawer-body');

                // ── Auto-scroll while dragging ────────────────────────────────
                // When the pointer/finger is within SCROLL_ZONE px of the top or
                // bottom edge of the drawer body, we scroll it continuously.
                const SCROLL_ZONE  = 60;  // px from edge that triggers scrolling
                const SCROLL_SPEED = 12;  // px per animation frame

                let scrollRaf = null;
                let scrollDir = 0; // -1 = up, 0 = none, +1 = down

                function startAutoScroll(direction) {
                    if (scrollDir === direction) return; // already scrolling this way
                    scrollDir = direction;
                    if (scrollRaf) cancelAnimationFrame(scrollRaf);
                    if (direction === 0) { scrollRaf = null; return; }
                    function tick() {
                        body.scrollTop += scrollDir * SCROLL_SPEED;
                        scrollRaf = requestAnimationFrame(tick);
                    }
                    scrollRaf = requestAnimationFrame(tick);
                }

                function stopAutoScroll() {
                    scrollDir = 0;
                    if (scrollRaf) { cancelAnimationFrame(scrollRaf); scrollRaf = null; }
                }

                function getScrollDir(clientY) {
                    const rect = body.getBoundingClientRect();
                    if (clientY < rect.top + SCROLL_ZONE)    return -1;
                    if (clientY > rect.bottom - SCROLL_ZONE) return  1;
                    return 0;
                }

                // ── Mouse drag (desktop) ──────────────────────────────────────
                body.addEventListener('dragstart', (e) => {
                    const item = e.target.closest('.queue-item');
                    if (!item) return;
                    dragSrc = item; isDragging = true;
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', '');
                    setTimeout(() => item.classList.add('dragging'), 0);
                });

                body.addEventListener('dragend', () => {
                    stopAutoScroll();
                    document.querySelectorAll('.queue-item.dragging').forEach(el => el.classList.remove('dragging'));
                    document.querySelectorAll('.queue-item.drag-over').forEach(el => el.classList.remove('drag-over'));
                    dragSrc = null; dragOverItem = null; isDragging = false;
                });

                body.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    startAutoScroll(getScrollDir(e.clientY));
                    const item = e.target.closest('.queue-item');
                    if (!item || item === dragSrc) return;
                    if (item !== dragOverItem) {
                        dragOverItem?.classList.remove('drag-over');
                        item.classList.add('drag-over');
                        dragOverItem = item;
                    }
                });

                body.addEventListener('dragleave', (e) => {
                    const item = e.target.closest('.queue-item');
                    if (!item || item.contains(e.relatedTarget)) return;
                    item.classList.remove('drag-over');
                    if (dragOverItem === item) dragOverItem = null;
                });

                body.addEventListener('drop', (e) => {
                    e.preventDefault();
                    stopAutoScroll();
                    const target = e.target.closest('.queue-item');
                    isDragging = false;
                    commitDrop(dragSrc, target);
                    dragOverItem = null; dragSrc = null;
                });

                // ── Touch drag (mobile) ───────────────────────────────────────
                // drag-handle  → instant drag on touchstart
                // q-art/q-info → long-press (300ms hold without moving) to activate
                //
                // During the long-press countdown the item gets a subtle scale-up so
                // the user knows something is about to happen. If the finger moves
                // more than CANCEL_MOVE px before the timer fires, we abort and let
                // normal scrolling happen.
                const LONG_PRESS_MS  = 300;
                const CANCEL_MOVE_PX = 8;

                let touchClone   = null;
                let touchSrc     = null;
                let touchOffsetX = 0, touchOffsetY = 0;

                // Long-press pending state
                let lpTimer      = null;  // setTimeout handle
                let lpItem       = null;  // item waiting to be confirmed
                let lpStartX     = 0;
                let lpStartY     = 0;

                function cancelLongPress() {
                    if (lpTimer) { clearTimeout(lpTimer); lpTimer = null; }
                    if (lpItem)  { lpItem.style.transform = ''; lpItem.style.transition = ''; lpItem = null; }
                }

                function activateDrag(item, touch) {
                    touchSrc  = item;
                    isDragging = true;
                    const rect = item.getBoundingClientRect();
                    touchOffsetX = touch.clientX - rect.left;
                    touchOffsetY = touch.clientY - rect.top;

                    // Reset any long-press transform before cloning
                    item.style.transform = '';
                    item.style.transition = '';

                    touchClone = item.cloneNode(true);
                    touchClone.style.cssText = `
                        position: fixed;
                        left: ${rect.left}px;
                        top: ${rect.top}px;
                        width: ${rect.width}px;
                        opacity: 0.85;
                        pointer-events: none;
                        z-index: 9999;
                        background: var(--surface2);
                        border: 1px solid var(--green);
                        border-radius: 6px;
                        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
                    `;
                    document.body.appendChild(touchClone);
                    item.classList.add('dragging');
                }

                body.addEventListener('touchstart', (e) => {
                    const handle  = e.target.closest('.drag-handle');
                    const softZone = e.target.closest('.q-art, .q-art-placeholder, .q-info, .q-name, .q-artist');

                    if (handle) {
                        // Instant drag from the handle
                        const item = handle.closest('.queue-item');
                        if (!item) return;
                        activateDrag(item, e.touches[0]);
                        return;
                    }

                    // Images should not start drag (they open as links on mobile)
                    if (softZone && e.target.tagName === 'IMG') return;

                    if (softZone) {
                        // Long-press required from art/info
                        const item = softZone.closest('.queue-item');
                        if (!item) return;
                        const touch = e.touches[0];
                        lpItem   = item;
                        lpStartX = touch.clientX;
                        lpStartY = touch.clientY;

                        // Visual "charging" feedback
                        item.style.transition = `transform ${LONG_PRESS_MS}ms ease`;
                        item.style.transform  = 'scale(1.03)';

                        lpTimer = setTimeout(() => {
                            lpTimer = null;
                            if (!lpItem) return;
                            const it = lpItem; lpItem = null;
                            // Re-fetch touch — use lpStart position for offset calc
                            const t = { clientX: lpStartX, clientY: lpStartY };
                            activateDrag(it, t);
                        }, LONG_PRESS_MS);
                        return;
                    }
                }, { passive: false });

                body.addEventListener('touchmove', (e) => {
                    // Cancel long-press if finger drifts before timer fires
                    if (lpItem) {
                        const t  = e.touches[0];
                        const dx = Math.abs(t.clientX - lpStartX);
                        const dy = Math.abs(t.clientY - lpStartY);
                        if (dx > CANCEL_MOVE_PX || dy > CANCEL_MOVE_PX) cancelLongPress();
                        if (!touchSrc) return; // still just scrolling — don't block
                    }

                    if (!touchSrc || !touchClone) return;
                    e.preventDefault(); // stop page scroll while dragging

                    const touch = e.touches[0];
                    touchClone.style.left = `${touch.clientX - touchOffsetX}px`;
                    touchClone.style.top  = `${touch.clientY - touchOffsetY}px`;

                    // Auto-scroll the drawer when finger is near the top/bottom edge
                    startAutoScroll(getScrollDir(touch.clientY));

                    // Highlight the item currently under the finger
                    touchClone.style.display = 'none';
                    const elUnder = document.elementFromPoint(touch.clientX, touch.clientY);
                    touchClone.style.display = '';
                    const overItem = elUnder?.closest('.queue-item');

                    if (overItem && overItem !== touchSrc) {
                        if (overItem !== dragOverItem) {
                            dragOverItem?.classList.remove('drag-over');
                            overItem.classList.add('drag-over');
                            dragOverItem = overItem;
                        }
                    } else if (!overItem) {
                        dragOverItem?.classList.remove('drag-over');
                        dragOverItem = null;
                    }
                }, { passive: false });

                body.addEventListener('touchend', (e) => {
                    cancelLongPress();
                    if (!touchSrc) return;
                    stopAutoScroll();

                    // Clean up clone and highlight
                    touchClone?.remove(); touchClone = null;
                    touchSrc.classList.remove('dragging');
                    document.querySelectorAll('.queue-item.drag-over').forEach(el => el.classList.remove('drag-over'));

                    // Hit-test for drop target
                    const touch = e.changedTouches[0];
                    const elUnder = document.elementFromPoint(touch.clientX, touch.clientY);
                    const target  = elUnder?.closest('.queue-item');

                    commitDrop(touchSrc, target);
                    touchSrc = null; dragOverItem = null; isDragging = false;
                }, { passive: true });

                body.addEventListener('touchcancel', () => {
                    cancelLongPress();
                    stopAutoScroll();
                    touchClone?.remove(); touchClone = null;
                    touchSrc?.classList.remove('dragging');
                    document.querySelectorAll('.queue-item.drag-over').forEach(el => el.classList.remove('drag-over'));
                    touchSrc = null; dragSrc = null; dragOverItem = null; isDragging = false;
                }, { passive: true });
            })();

            // ── Helpers ───────────────────────────────────────────────────────────────
            function msToTime(ms) {
                const s = Math.floor(ms / 1000);
                return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
            }

            let toastTimeout;
            function showToast(msg) {
                let t = document.getElementById('toast');
                if (!t) {
                    t = document.createElement('div');
                    t.id = 'toast';
                    t.style.cssText = `position:fixed;bottom:104px;left:50%;transform:translateX(-50%);
                        background:var(--green);color:#000;font-family:'DM Mono',monospace;
                        font-size:0.75rem;font-weight:600;padding:8px 18px;border-radius:100px;
                        z-index:300;opacity:0;transition:opacity 0.2s;pointer-events:none;`;
                    document.body.appendChild(t);
                }
                t.textContent = msg; t.style.opacity = '1';
                clearTimeout(toastTimeout);
                toastTimeout = setTimeout(() => { t.style.opacity = '0'; }, 2200);
            }

            renderQueue();
        </script>
    </body>
</html>
