            // Load playlists
            async function loadPlaylists() {
                const container = document.getElementById('playlist-list');
                try {
                    const res  = await fetch('/spotify/playlists');
                    const data = await res.json();

                    if (!res.ok) {
                        const retryMsg = data.retryAfter ? ` (retry in ${data.retryAfter}s)` : '';
                        container.innerHTML = `<div style="padding:8px 14px;font-size:0.72rem;color:#e74c3c;font-style:italic;">
                            ${res.status === 429 ? `Rate limited by Spotify${retryMsg} — open the sidebar again in a moment` : (data.error || 'Failed to load')}
                            <br/><button onclick="playlistsLoaded=false;loadPlaylists()" style="margin-top:6px;background:none;border:1px solid var(--muted);color:var(--muted2);border-radius:4px;padding:3px 8px;cursor:pointer;font-size:0.68rem;">Retry</button>
                        </div>`;
                        return;
                    }

                    container.innerHTML = '';
                    if (data.length === 0) {
                        container.innerHTML = `<div style="padding:8px 14px;font-size:0.72rem;color:var(--muted);font-style:italic;">No playlists found</div>`;
                        return;
                    }
                    data.filter(pl => !pl.isSpotifyOwned).forEach(pl => {
                        const item = document.createElement('div');
                        item.className = 'source-item';
                        item.dataset.source = pl.id;
                        item.innerHTML = `
                            ${pl.image
                                ? `<img class="source-art" src="${pl.image}" alt="${pl.name}" />`
                                : `<div class="source-art-placeholder"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/></svg></div>`}
                            <div class="source-info"><div class="source-name">${pl.name}</div></div>
                        `;
                        item.addEventListener('click', () => switchSource(pl.id, pl.name));
                        container.appendChild(item);
                    });
                } catch (e) {
                    container.innerHTML = `<div style="padding:8px 14px;font-size:0.72rem;color:var(--muted);font-style:italic;">Failed to load</div>`;
                }

            }


            // ── Infinite scroll ───────────────────────────────────────────────────────
            async function loadMoreLikedSongs() {
                if (likedLoading || likedExhausted || currentSource !== 'liked') return;
                likedLoading = true;
                try {
                    const res = await fetch(`/spotify/liked?offset=${likedOffset}&limit=50`);
                    if (!res.ok) { likedLoading = false; return; }
                    const songs = await res.json();
                    if (songs.length === 0) {
                        likedExhausted = true;
                        document.getElementById('scroll-sentinel')?.remove();
                        likedLoading = false; return;
                    }
                    allSongs.push(...songs);
                    likedOffset += songs.length;
                    if (currentSource === 'liked') {
                        currentSongs = [...allSongs];
                        const list  = document.getElementById('song-list');
                        const query = document.getElementById('search').value.trim();
                        if (!query) {
                            const startIdx = allSongs.length - songs.length;
                            songs.forEach((song, i) => {
                                const row = makeSongRow(song, startIdx + i);
                                list.insertBefore(row, document.getElementById('scroll-sentinel'));
                            });
                            document.getElementById('count-label').textContent = `${allSongs.length} SONGS`;
                        }
                    }
                } catch (e) {}
                likedLoading = false;
            }

            function attachScrollSentinel() {
                document.getElementById('scroll-sentinel')?.remove();
                const sentinel = document.createElement('div');
                sentinel.id = 'scroll-sentinel';
                sentinel.style.height = '1px';
                document.getElementById('song-list').appendChild(sentinel);
                const observer = new IntersectionObserver((entries) => {
                    if (entries[0].isIntersecting) loadMoreLikedSongs();
                }, { rootMargin: '200px' });
                observer.observe(sentinel);
            }

