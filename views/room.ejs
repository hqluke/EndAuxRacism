<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <title>EndAuxRacism — Room</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap"
            rel="stylesheet"
        />
        <link rel="stylesheet" href="/rooms.css" />
    </head>
    <body>
        <header>
            <div class="header-left">
                <a href="/spotify/dashboard" class="logo">EndAuxRacism</a>
                <% if (isHost) { %><span class="host-badge">HOST</span><% } %>
                <div
                    class="room-id-pill"
                    id="copy-room-link"
                    title="Tap to copy invite link / hold to see listeners"
                >
                    <div class="listener-dot"></div>
                    <span id="listener-label">1 listener</span>
                    <svg
                        width="11"
                        height="11"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        style="margin-left: 4px; color: var(--muted)"
                    >
                        <path
                            d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
                        />
                        <path
                            d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
                        />
                    </svg>
                </div>
                <div id="listener-list-dropdown" class="listener-dropdown" style="display: none">
                    <div class="listener-dropdown-title">Listeners</div>
                    <div id="listener-list-body"></div>
                </div>
            </div>

            <div class="header-right">
                <% if (user) { %>
                <button
                    id="btn-library-toggle"
                    class="active"
                    title="Toggle library"
                >
                    <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z" />
                    </svg>
                    Library
                </button>
                <% if (isHost) { %>
                <button
                    id="btn-spotify-connect-header"
                    class="btn-connect-header"
                    title="Choose playback device"
                    style="display: none"
                >
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 168 168"
                        fill="currentColor"
                    >
                        <path
                            d="M84 0C37.6 0 0 37.6 0 84s37.6 84 84 84 84-37.6 84-84S130.4 0 84 0zm38.6 121.2c-1.6 2.6-5 3.4-7.6 1.8-20.8-12.7-47-15.6-77.8-8.6-3 .7-6-1.2-6.6-4.2-.7-3 1.2-6 4.2-6.6 33.7-7.7 62.6-4.4 86 9.9 2.5 1.6 3.3 5 1.8 7.7zm10.3-22.9c-2 3.2-6.2 4.2-9.4 2.2-23.8-14.6-60-18.9-88.1-10.3-3.6 1.1-7.4-1-8.5-4.6-1.1-3.6 1-7.4 4.6-8.5 32.1-9.8 71.9-5 99.2 11.8 3.1 1.9 4.1 6.2 2.2 9.4zm.9-23.8C108.4 57.5 58.3 55.8 29 64.5c-4.4 1.3-9-.9-10.3-5.3-1.3-4.4.9-9 5.3-10.3C57.8 39.2 112.2 41.2 141 60c4 2.4 5.2 7.6 2.8 11.5z"
                        />
                    </svg>
                    Connect
                </button>
                <% } %>
                <div class="user-pill">
                    <% if (user.avatar) { %>
                    <img
                        src="<%= user.avatar %>"
                        alt="<%= user.displayName %>"
                    />
                    <% } else { %>
                    <div class="avatar-placeholder">
                        <%= user.displayName?.charAt(0).toUpperCase() %>
                    </div>
                    <% } %>
                    <span><%= user.displayName %></span>
                </div>
                <a href="/logout" class="btn-text">log out</a>
                <% } else { %>
                <button
                    id="btn-library-toggle"
                    class="active"
                    title="Toggle playlists"
                >
                    <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z" />
                    </svg>
                    Playlists
                </button>
                <a href="/auth/spotify" class="btn-text green"
                    >login with spotify</a
                >
                <% } %>
            </div>
        </header>

        <!-- Sidebar backdrop (mobile only) -->
        <div id="sidebar-backdrop"></div>

        <div class="layout">
            <!-- ── Library Sidebar (Spotify users only) ── -->
            <% if (user) { %>
            <div id="library-sidebar">
                <div class="sidebar-header">
                    <span class="sidebar-title">Library</span>
                </div>
                <div class="sidebar-body">
                    <div class="sidebar-section-label">Songs</div>
                    <div
                        class="source-item liked active"
                        id="source-liked"
                        data-source="liked"
                    >
                        <div class="source-art-placeholder">
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                            >
                                <path
                                    d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                />
                            </svg>
                        </div>
                        <div class="source-info">
                            <div class="source-name">Liked Songs</div>
                        </div>
                    </div>
                    <div class="sidebar-section-label">Playlists</div>
                    <div id="playlist-list">
                        <div
                            style="
                                padding: 8px 14px;
                                font-size: 0.72rem;
                                color: var(--muted);
                                font-style: italic;
                            "
                        >
                            Loading...
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- ── Guest sidebar (Apple Music playlists from localStorage) ── -->
            <% if (!user) { %>
            <div id="library-sidebar">
                <div class="sidebar-header">
                    <span class="sidebar-title">My Playlists</span>
                </div>
                <div class="sidebar-body" id="guest-sidebar-body">
                    <!-- Rendered by JS from localStorage -->
                </div>
            </div>
            <% } %>

            <!-- ── Main content ── -->
            <% if (user) { %>
            <main>
                <div class="section-header">
                    <div class="header-title-group">
                        <h1 id="source-title">Liked Songs</h1>
                        <span class="count" id="count-label">50 SONGS</span>
                        <button
                            class="btn-shuffle-library"
                            id="btn-shuffle-library"
                            title="Shuffle (coming soon)"
                        >
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <polyline points="16 3 21 3 21 8" />
                                <line x1="4" y1="20" x2="21" y2="3" />
                                <polyline points="21 16 21 21 16 21" />
                                <line x1="15" y1="15" x2="21" y2="21" />
                            </svg>
                            Shuffle
                        </button>
                    </div>
                </div>
                <div class="search-row">
                    <div class="search-wrap">
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.35-4.35" />
                        </svg>
                        <input
                            id="search"
                            type="text"
                            placeholder="search songs..."
                            autocomplete="off"
                        />
                    </div>
                    <button
                        class="btn-search-clear"
                        id="btn-search-clear"
                        style="display: none"
                        title="Clear search"
                    >
                        <svg
                            width="13"
                            height="13"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                        >
                            <path d="M18 6 6 18M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <div class="song-list" id="song-list"></div>
                <div class="no-results" id="no-results">no matches found</div>
            </main>

            <% } else { %>

            <!-- ── Guest panel (no Spotify login) ── -->
            <div id="guest-panel">
                <!-- Import bar at top -->
                <div id="guest-import-bar">
                    <div
                        style="
                            display: flex;
                            align-items: center;
                            gap: 10px;
                            flex: 1;
                            min-width: 0;
                        "
                    >
                        <div
                            class="import-card-icon apple"
                            style="flex-shrink: 0"
                        >
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="white"
                            >
                                <path
                                    d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
                                />
                            </svg>
                        </div>
                        <input
                            class="import-input"
                            id="apple-url-input"
                            type="url"
                            placeholder="Paste Apple Music playlist link..."
                            style="flex: 1"
                        />
                    </div>
                    <button class="btn-import" id="btn-apple-import">
                        Import
                    </button>
                    <a
                        href="/auth/spotify"
                        class="btn-text green"
                        style="white-space: nowrap; font-size: 0.7rem"
                    >
                        Login with Spotify
                    </a>
                </div>

                <!-- Status / loading message -->
                <div
                    id="import-status"
                    style="
                        display: none;
                        font-size: 0.75rem;
                        color: var(--muted);
                        padding: 0 0 16px;
                    "
                ></div>

                <!-- Song list (shown once a playlist is selected) -->
                <div id="guest-source-header" style="display: none">
                    <div class="section-header" style="margin-bottom: 12px">
                        <div class="header-title-group">
                            <h1
                                id="guest-source-title"
                                style="font-size: 1.4rem"
                            ></h1>
                            <span class="count" id="guest-count-label"></span>
                        </div>
                    </div>
                    <div class="search-row" style="margin-bottom: 20px">
                        <div class="search-wrap">
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <circle cx="11" cy="11" r="8" />
                                <path d="m21 21-4.35-4.35" />
                            </svg>
                            <input
                                id="guest-search"
                                type="text"
                                placeholder="search songs..."
                                autocomplete="off"
                            />
                        </div>
                        <button
                            class="btn-search-clear"
                            id="btn-guest-search-clear"
                            style="display: none"
                            title="Clear search"
                        >
                            <svg
                                width="13"
                                height="13"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                            >
                                <path d="M18 6 6 18M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="song-list" id="guest-song-list"></div>
                <div
                    class="no-results"
                    id="guest-no-results"
                    style="display: none"
                >
                    no matches found
                </div>

                <!-- Empty state shown before any playlist is selected -->
                <div
                    id="guest-empty"
                    style="
                        text-align: center;
                        padding: 80px 0;
                        color: var(--muted);
                    "
                >
                    <div style="font-size: 2rem; margin-bottom: 12px">🎵</div>
                    <p style="font-size: 0.85rem; line-height: 1.7">
                        Paste an Apple Music playlist link above<br />to browse
                        and queue songs.
                    </p>
                </div>
            </div>
            <% } %>
        </div>
        <!-- /.layout -->

        <!-- ── Spotify Connect Modal (host only) ── -->
        <% if (isHost) { %>
        <div id="connect-modal-overlay" style="display: none">
            <div id="connect-modal">
                <div class="connect-modal-header">
                    <span class="connect-modal-title">
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            style="color: var(--green); flex-shrink: 0"
                        >
                            <path
                                d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"
                            />
                        </svg>
                        Spotify Connect
                    </span>
                    <button id="btn-close-connect-modal">
                        <svg
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path d="M18 6 6 18M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <p class="connect-modal-hint">
                    Select a device to transfer playback. The queue will keep
                    working on any device.
                </p>
                <div id="connect-device-list">
                    <div class="connect-loading">Scanning for devices...</div>
                </div>
                <div id="connect-modal-error" style="display: none"></div>
                <div class="connect-modal-footer">
                    <span id="connect-polling-status"></span>
                    <button
                        id="btn-refresh-devices"
                        class="btn-connect-refresh"
                    >
                        <svg
                            width="13"
                            height="13"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                        >
                            <path d="M1 4v6h6M23 20v-6h-6" />
                            <path
                                d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4-4.64 4.36A9 9 0 0 1 3.51 15"
                            />
                        </svg>
                        Refresh
                    </button>
                </div>
            </div>
        </div>
        <% } %>

        <!-- ── Queue Backdrop (mobile overlay) ── -->
        <div id="queue-backdrop"></div>

        <!-- ── Queue Drawer ── -->
        <div id="queue-drawer">
            <div class="drawer-header">
                <span class="drawer-title">Queue</span>
                <button
                    id="btn-shuffle-queue"
                    class="btn-shuffle-library"
                    title="Shuffle manual queue"
                >
                    <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <polyline points="16 3 21 3 21 8" />
                        <line x1="4" y1="20" x2="21" y2="3" />
                        <polyline points="21 16 21 21 16 21" />
                        <line x1="15" y1="15" x2="21" y2="21" />
                    </svg>
                    Shuffle
                </button>
                <button id="btn-close-drawer">
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path d="M18 6 6 18M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="drawer-body" id="drawer-body"></div>
        </div>

        <!-- ── Player Bar (host) ── -->
        <% if (isHost) { %>
        <div id="player-bar">
            <div id="player-bar-progress">
                <div id="player-bar-progress-fill"></div>
            </div>
            <div class="now-playing" id="now-playing-tap" title="Expand player">
                <img id="np-art" src="" alt="" style="opacity: 0" />
                <div class="np-text">
                    <div id="np-name" style="color: var(--muted)">
                        Not playing
                    </div>
                    <div id="np-artist"></div>
                </div>
            </div>
            <div class="player-controls">
                <button class="ctrl-btn" id="btn-prev" title="Previous">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path d="M6 6h2v12H6zm3.5 6 8.5 6V6z" />
                    </svg>
                </button>
                <button
                    class="ctrl-btn"
                    id="btn-play-pause"
                    title="Play / Pause"
                >
                    <svg
                        id="icon-play"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path d="M8 5v14l11-7z" />
                    </svg>
                    <svg
                        id="icon-pause"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        style="display: none"
                    >
                        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                    </svg>
                </button>
                <button class="ctrl-btn" id="btn-next" title="Next">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path d="m6 18 8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                    </svg>
                </button>
            </div>
            <div class="player-bar-right">
                <span id="sdk-status-bar"></span>
                <button id="btn-queue-toggle">
                    <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path
                            d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"
                        />
                    </svg>
                    Queue
                </button>
            </div>
        </div>

        <!-- ── Now Playing Full-Screen Modal ── -->
        <div id="np-modal" class="np-modal" aria-hidden="true">
            <button id="np-modal-close" class="np-modal-close" title="Close">
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                >
                    <path d="M18 6 6 18M6 6l12 12" />
                </svg>
            </button>
            <div class="np-modal-inner" id="np-modal-inner">
                <img id="np-modal-art" src="" alt="" class="np-modal-art" />
                <div class="np-modal-info">
                    <div id="np-modal-name" class="np-modal-name">
                        Not playing
                    </div>
                    <div id="np-modal-artist" class="np-modal-artist"></div>
                </div>
                <div class="np-modal-progress">
                    <div class="progress-wrap">
                        <span class="time-label" id="np-modal-time-current"
                            >0:00</span
                        >
                        <div
                            id="np-modal-progress-bar"
                            class="np-modal-progress-bar"
                        >
                            <div
                                id="np-modal-progress-fill"
                                class="np-modal-progress-fill"
                            ></div>
                        </div>
                        <span class="time-label right" id="np-modal-time-total"
                            >0:00</span
                        >
                    </div>
                </div>
                <div class="np-modal-controls">
                    <button
                        class="ctrl-btn np-modal-ctrl-btn"
                        id="np-modal-btn-shuffle"
                        title="Shuffle (coming soon)"
                    >
                        <svg
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <polyline points="16 3 21 3 21 8" />
                            <line x1="4" y1="20" x2="21" y2="3" />
                            <polyline points="21 16 21 21 16 21" />
                            <line x1="15" y1="15" x2="21" y2="21" />
                        </svg>
                    </button>
                    <button
                        class="ctrl-btn np-modal-ctrl-btn"
                        id="np-modal-btn-prev"
                        title="Previous"
                    >
                        <svg
                            width="28"
                            height="28"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                        >
                            <path d="M6 6h2v12H6zm3.5 6 8.5 6V6z" />
                        </svg>
                    </button>
                    <button
                        class="np-modal-play-pause"
                        id="np-modal-btn-play-pause"
                        title="Play / Pause"
                    >
                        <svg
                            id="np-modal-icon-play"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                        >
                            <path d="M8 5v14l11-7z" />
                        </svg>
                        <svg
                            id="np-modal-icon-pause"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            style="display: none"
                        >
                            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                        </svg>
                    </button>
                    <button
                        class="ctrl-btn np-modal-ctrl-btn"
                        id="np-modal-btn-next"
                        title="Next"
                    >
                        <svg
                            width="28"
                            height="28"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                        >
                            <path d="m6 18 8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                        </svg>
                    </button>
                    <button
                        class="ctrl-btn np-modal-ctrl-btn"
                        id="np-modal-btn-queue"
                        title="Queue"
                    >
                        <svg
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                        >
                            <path
                                d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"
                            />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <% } else { %>
        <!-- ── Guest Bar ── -->
        <div id="guest-bar">
            <div id="guest-bar-progress">
                <div id="guest-bar-progress-fill"></div>
            </div>
            <div id="guest-np" id="guest-np-tap" title="Expand player">
                <img id="guest-np-art" src="" alt="" />
                <div>
                    <div id="guest-np-name">Waiting for host...</div>
                    <div id="guest-np-artist"></div>
                </div>
            </div>
            <div class="guest-bar-controls">
                <button id="btn-guest-prev" title="Previous song">
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path d="M6 6h2v12H6zm3.5 6 8.5 6V6z" />
                    </svg>
                    Back
                </button>
                <button id="btn-guest-skip" title="Skip song">
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path d="m6 18 8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                    </svg>
                    Skip
                </button>
                <button id="btn-queue-toggle">
                    <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                    >
                        <path
                            d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"
                        />
                    </svg>
                    Queue
                </button>
            </div>
        </div>

        <!-- ── Guest Now Playing Modal ── -->
        <div id="guest-np-modal" class="np-modal" aria-hidden="true">
            <button
                id="guest-np-modal-close"
                class="np-modal-close"
                title="Close"
            >
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                >
                    <path d="M18 6 6 18M6 6l12 12" />
                </svg>
            </button>
            <div class="np-modal-inner" id="guest-np-modal-inner">
                <img
                    id="guest-np-modal-art"
                    src=""
                    alt=""
                    class="np-modal-art"
                />
                <div class="np-modal-info">
                    <div id="guest-np-modal-name" class="np-modal-name">
                        Waiting for host...
                    </div>
                    <div
                        id="guest-np-modal-artist"
                        class="np-modal-artist"
                    ></div>
                </div>
                <div class="np-modal-progress">
                    <div class="progress-wrap">
                        <span
                            class="time-label"
                            id="guest-np-modal-time-current"
                            >0:00</span
                        >
                        <div
                            id="guest-np-modal-progress-bar"
                            class="np-modal-progress-bar"
                        >
                            <div
                                id="guest-np-modal-progress-fill"
                                class="np-modal-progress-fill"
                            ></div>
                        </div>
                        <span
                            class="time-label right"
                            id="guest-np-modal-time-total"
                            >0:00</span
                        >
                    </div>
                </div>
                <div class="np-modal-controls">
                    <button
                        class="ctrl-btn np-modal-ctrl-btn np-modal-ctrl-btn--placeholder"
                        title="Guests cannot pause"
                        style="opacity: 0; pointer-events: none"
                    >
                        <!-- placeholder to keep layout symmetric -->
                        <svg
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <circle cx="12" cy="12" r="1" />
                        </svg>
                    </button>
                    <button
                        class="ctrl-btn np-modal-ctrl-btn"
                        id="guest-np-modal-btn-prev"
                        title="Back"
                    >
                        <svg
                            width="28"
                            height="28"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                        >
                            <path d="M6 6h2v12H6zm3.5 6 8.5 6V6z" />
                        </svg>
                    </button>
                    <button
                        class="ctrl-btn np-modal-ctrl-btn"
                        id="guest-np-modal-btn-next"
                        title="Skip"
                    >
                        <svg
                            width="28"
                            height="28"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                        >
                            <path d="m6 18 8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                        </svg>
                    </button>
                    <button
                        class="ctrl-btn np-modal-ctrl-btn"
                        id="guest-np-modal-btn-queue"
                        title="Queue"
                    >
                        <svg
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                        >
                            <path
                                d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"
                            />
                        </svg>
                    </button>
                </div>
            </div>
        </div>
        <% } %> <% if (isHost) { %>
        <script src="https://sdk.scdn.co/spotify-player.js"></script>
        <% } %>
        <script src="/socket.io/socket.io.js"></script>
        <script>
            // ── Server data ───────────────────────────────────────────────────────────
            const allSongs = <%- JSON.stringify(songs || []) %>;
            const roomId   = '<%- roomId %>';
            const isHost   = <%= isHost %>;
            const isLoggedIn = <%= user ? 'true' : 'false' %>;

            // ── State ─────────────────────────────────────────────────────────────────
            let deviceId         = null;  // browser SDK device ID — never changes after ready
            let activeDeviceId   = null;  // currently active playback device — may be phone/desktop
            let player           = null;
            let currentTrackUri  = null;
            let nowPlayingSong   = null;   // { name, artist, image, uri } — shared host+guest
            let isPlaying        = false;
            let progressInterval = null;
            let currentPosition  = 0;
            let currentDuration  = 0;
            let manualQueue      = [];
            let autoQueue        = [];
            let isDragging       = false;
            let lastAdvancedUri  = null;
            let appTriggeredUri  = null;  // URI of last song WE triggered — stops polling/SDK from double-advancing
            // NOTE: Near-end queue advancement is handled server-side by playbackManager.
            // The client only handles manual skips (next/prev buttons, guest skip).
            let historyStack     = []; // up to 10 previously played songs
            let shuffleEnabled   = false; // shuffle mode toggle

            // Library state
            let currentSource    = 'liked';
            let currentSongs     = [...allSongs];
            let playlistCache    = {};

            // Infinite scroll state
            let likedOffset    = allSongs.length;
            let likedLoading   = false;
            let likedExhausted = false;
            let autoQueueOffset = allSongs.length;

            // ── Socket ────────────────────────────────────────────────────────────────
            const socket = io();

            socket.on('connect', () => {
                socket.emit('join-room', roomId);
                // Guests: fetch current now-playing state to seed the progress bar
                // in case the socket now-playing event arrives before this resolves.
                if (!isHost) {
                    fetch(`/rooms/${roomId}/now-playing`)
                        .then(r => r.json())
                        .then(song => {
                            if (!song) return;
                            nowPlayingSong = song;
                            updateGuestNowPlaying(song);
                            startGuestProgressTicker();
                        })
                        .catch(() => {});
                }
            });

            socket.on('queue-state', ({ manualQueue: mq, autoQueue: aq, listenerCount }) => {
                if (isDragging) return;
                const prevNext = (manualQueue[0] || autoQueue[0])?.uri;
                manualQueue = mq || [];
                autoQueue   = aq || [];
                renderQueue();
                if (listenerCount !== undefined) {
                    const el = document.getElementById('listener-label');
                    if (el) el.textContent = `${listenerCount} listener${listenerCount === 1 ? '' : 's'}`;
                }
                const newNext = (manualQueue[0] || autoQueue[0])?.uri;
                if (isHost && newNext && newNext !== prevNext) {
                    console.log(`[queue-state] next-up changed: "${prevNext?.slice(-6) ?? 'null'}" → "${newNext.slice(-6)}"`);
                }
            });

            socket.on('play-track', (song) => {
                // Emitted by the server when the queue advances (manual skip or
                // server-side near-end detection). Always call playSong — the server
                // is the source of truth and has already decided what plays next.
                console.log(`[play-track] "${song.name}" | currentTrackUri=${currentTrackUri?.slice(-6) ?? 'null'}`);
                nowPlayingSong = song;
                renderQueue();
                if (isHost) {
                    playSong(song.uri, false);
                } else {
                    updateGuestNowPlaying(song);
                    startGuestProgressTicker();
                }
            });

            socket.on('now-playing', (song) => {
                // Don't set currentTrackUri here — only the host's player_state_changed owns it
                nowPlayingSong = song;
                renderQueue();
                if (!isHost) {
                    updateGuestNowPlaying(song);
                    startGuestProgressTicker();
                }
            });

            socket.on('user-joined', ({ displayName, listenerCount }) => {
                showToast(`${displayName} joined`);
            });
            socket.on('user-left', ({ displayName, listenerCount }) => {
                showToast(`${displayName} left`);
            });

            // Dedicated listener count event — always updates the label for everyone
            socket.on('listener-count', ({ listenerCount }) => {
                const el = document.getElementById('listener-label');
                if (el) el.textContent = `${listenerCount} listener${listenerCount === 1 ? '' : 's'}`;
            });

            // ── Progress sync (guests) ────────────────────────────────────────────
            socket.on('progress-sync', ({ uri, progress_ms, duration_ms }) => {
                if (isHost) return;
                if (nowPlayingSong && nowPlayingSong.uri === uri) {
                    guestCurrentPosition = progress_ms;
                    guestCurrentDuration = duration_ms;
                    updateGuestProgress();
                }
            });

            // ── Host seek broadcast ─────────────────────────────────────────────
            socket.on('host-seek', ({ position_ms }) => {
                if (isHost) return;
                guestCurrentPosition = position_ms;
                updateGuestProgress();
            });

            // ── Listener list (long-press) ─────────────────────────────────────────
            socket.on('listener-list', ({ listeners }) => {
                window._listenerList = listeners || [];
            });

            (function initListenerLongPress() {
                const pill = document.getElementById('copy-room-link');
                const dropdown = document.getElementById('listener-list-dropdown');
                const body = document.getElementById('listener-list-body');
                if (!pill || !dropdown || !body) return;

                let holdTimer = null;
                let didHold = false;
                const HOLD_MS = 500;

                function showDropdown() {
                    const list = window._listenerList || [];
                    body.innerHTML = '';
                    if (list.length === 0) {
                        body.innerHTML = '<div class="listener-dropdown-empty">No listeners</div>';
                    } else {
                        list.forEach(l => {
                            const chip = document.createElement('div');
                            chip.className = 'listener-dropdown-chip';
                            chip.textContent = l.displayName;
                            body.appendChild(chip);
                        });
                    }
                    dropdown.style.display = 'block';
                }

                function hideDropdown() {
                    dropdown.style.display = 'none';
                }

                function onStart(e) {
                    didHold = false;
                    holdTimer = setTimeout(() => {
                        didHold = true;
                        showDropdown();
                    }, HOLD_MS);
                }

                function onEnd(e) {
                    clearTimeout(holdTimer);
                    if (!didHold) {
                        navigator.clipboard.writeText(`${window.location.origin}/rooms/${roomId}`)
                            .then(() => showToast('Invite link copied!'));
                    }
                }

                function onCancel() {
                    clearTimeout(holdTimer);
                }

                pill.addEventListener('mousedown', onStart);
                pill.addEventListener('mouseup', onEnd);
                pill.addEventListener('mouseleave', onCancel);
                pill.addEventListener('touchstart', onStart, { passive: true });
                pill.addEventListener('touchend', onEnd);
                pill.addEventListener('touchcancel', onCancel);

                document.addEventListener('mousedown', (e) => {
                    if (!dropdown.contains(e.target) && !pill.contains(e.target)) hideDropdown();
                });
            })();

            // Guest requested back — host executes it on their behalf
            socket.on('guest-request-back', () => {
                if (!isHost) return;
                document.getElementById('btn-prev')?.click();
            });

            // ── Queue drawer ──────────────────────────────────────────────────────────
            const drawer      = document.getElementById('queue-drawer');
            const toggleBtn   = document.getElementById('btn-queue-toggle');
            const closeBtn    = document.getElementById('btn-close-drawer');
            const qBackdrop   = document.getElementById('queue-backdrop');

            function openDrawer() {
                drawer.classList.add('open');
                document.body.classList.add('drawer-open');
                toggleBtn.classList.add('active');
                qBackdrop.classList.add('visible');
            }
            function closeDrawer() {
                drawer.classList.remove('open');
                document.body.classList.remove('drawer-open');
                toggleBtn.classList.remove('active');
                qBackdrop.classList.remove('visible');
            }

            toggleBtn.addEventListener('click', () => drawer.classList.contains('open') ? closeDrawer() : openDrawer());
            closeBtn.addEventListener('click', closeDrawer);

            // Tap backdrop to close (mobile)
            qBackdrop.addEventListener('click', closeDrawer);

            // ── Swipe right on backdrop to close (mobile) ─────────────────────────────
            // The backdrop sits to the left of the drawer — swiping rightward on it
            // mirrors the feel of the drawer dismissing without fighting browser back nav.
            (function initBackdropSwipe() {
                let swipeStartX = null;
                let swipeStartY = null;
                const SWIPE_H_THRESHOLD = 16;
                const SWIPE_V_LOCK      = 14;

                qBackdrop.addEventListener('touchstart', (e) => {
                    const t = e.touches[0];
                    swipeStartX = t.clientX;
                    swipeStartY = t.clientY;
                }, { passive: true });

                qBackdrop.addEventListener('touchmove', (e) => {
                    if (swipeStartX === null) return;
                    const dx = e.touches[0].clientX - swipeStartX;
                    const dy = Math.abs(e.touches[0].clientY - swipeStartY);
                    if (dy > SWIPE_V_LOCK && Math.abs(dx) < dy) { swipeStartX = null; return; }
                }, { passive: true });

                qBackdrop.addEventListener('touchend', (e) => {
                    if (swipeStartX === null) return;
                    const dx = e.changedTouches[0].clientX - swipeStartX;
                    if (dx > SWIPE_H_THRESHOLD) closeDrawer();
                    swipeStartX = null;
                }, { passive: true });

                qBackdrop.addEventListener('touchcancel', () => { swipeStartX = null; }, { passive: true });
            })();

            // ── Fisher-Yates shuffle — used by both host and guests ───────────────────
            function fisherYates(arr) {
                const a = [...arr];
                for (let i = a.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [a[i], a[j]] = [a[j], a[i]];
                }
                return a;
            }

            // ── Shuffle manual queue (available to everyone) ──────────────────────────
            document.getElementById('btn-shuffle-queue').addEventListener('click', () => {
                if (manualQueue.length < 2) return;
                const shuffled = fisherYates([...manualQueue]);
                manualQueue = shuffled;
                renderQueue();
                socket.emit('queue-set-manual', { roomId, songs: shuffled });
                const btn = document.getElementById('btn-shuffle-queue');
                btn.classList.add('shuffle-active');
                setTimeout(() => btn.classList.remove('shuffle-active'), 600);
            });

            // ── Spotify SDK (host only) ───────────────────────────────────────────────
            <% if (isHost) { %>
            window.onSpotifyWebPlaybackSDKReady = async () => {
                player = new Spotify.Player({
                    name: 'EndAuxRacism Room',
                    getOAuthToken: async (cb) => {
                        const data = await fetch('/spotify/token').then(r => r.json());
                        cb(data.accessToken);
                    },
                    volume: 0.8,
                });

                player.addListener('player_state_changed', (state) => {
                    if (!state) return;

                    // The Spotify SDK fires player_state_changed even when another device
                    // (e.g. the host's phone) is the active player — it mirrors state.
                    // Only reclaim SDK control if the browser SDK is actually the active
                    // device, i.e. activeDeviceId still points at the browser SDK device.
                    const sdkIsActive = activeDeviceId === deviceId;

                    if (sdkIsActive) {
                        sdkIsActiveDevice = true;
                        stopPolling();
                    }
                    // If the SDK is just mirroring another device, ignore this event —
                    // polling owns state in that case.
                    if (!sdkIsActive) return;

                    const track = state.track_window.current_track;
                    const prevUri = currentTrackUri;
                    isPlaying       = !state.paused;
                    currentPosition = state.position;
                    currentDuration = state.duration;
                    currentTrackUri = track.uri;

                    updateNowPlaying(track);
                    updatePlayPauseIcon();
                    updateProgress();

                    const songData = { name: track.name, artist: track.artists.map(a => a.name).join(', '), image: track.album?.images?.[0]?.url || '', uri: track.uri };

                    // Only update nowPlayingSong and re-render when the track actually changes
                    if (prevUri !== track.uri) {
                        nowPlayingSong = songData;
                        renderQueue();

                        console.log(`[sdk] track changed: "${track.name}" | prevUri=${prevUri?.slice(-6) ?? 'null'} appTriggered=${appTriggeredUri?.slice(-6) ?? 'null'}`);

                        // Broadcast to guests and server so now-playing stays in sync.
                        // The server's playbackManager is the source of truth for advancing
                        // the queue — we don't call queue-advance from the client on track change.
                        socket.emit('now-playing-broadcast', { roomId, song: songData });
                    }

                    clearInterval(progressInterval);
                    if (isPlaying) {
                        progressInterval = setInterval(() => {
                            currentPosition += 500;
                            updateProgress();

                            // Near-end advancement is handled server-side by playbackManager.
                            // No client-side queue advance needed here.
                        }, 500);
                    }

                    if (autoQueue.length < 10) fetchMoreSongs();
                });

                player.addListener('initialization_error', ({ message }) => setStatus('error', `Init: ${message}`));
                player.addListener('authentication_error',  ({ message }) => setStatus('error', `Auth: ${message}`));
                player.addListener('account_error', () => setStatus('error', 'Premium required'));

                // Hook into SDK ready/not_ready to track whether SDK is the active device
                player.addListener('ready', ({ device_id }) => {
                    deviceId = device_id;
                    activeDeviceId = device_id;
                    sdkIsActiveDevice = true;
                    stopPolling();
                    setStatus('ready', '● Ready');
                    // Reveal the Connect button in both the player bar (legacy hidden) and header
                    const connectBtnLegacy = document.getElementById('btn-spotify-connect');
                    if (connectBtnLegacy) connectBtnLegacy.style.display = '';
                    const connectBtnH = document.getElementById('btn-spotify-connect-header');
                    if (connectBtnH) connectBtnH.style.display = '';
                });

                player.addListener('not_ready', () => {
                    sdkIsActiveDevice = false;
                    setStatus('error', '✕ Disconnected');
                    startPolling();
                });

                player.connect();
            };

            // Guards the transport play/pause button against the startup race: right
            // after login the SDK may not have fired 'ready' yet (player/activeDeviceId
            // still unset), or 'ready' has fired but no track has ever been loaded into
            // this device yet (togglePlay is a no-op with nothing to toggle). Both cases
            // used to silently do nothing — now they tell the user why.
            async function togglePlayPause() {
                if (!player || !activeDeviceId) {
                    showToast('Still connecting to Spotify — try again in a moment');
                    return;
                }
                if (!nowPlayingSong) {
                    showToast('Pick a song to start playing');
                    return;
                }
                try {
                    await player.togglePlay();
                } catch (e) {
                    showToast('Playback control failed — try again');
                }
            }

            document.getElementById('btn-play-pause').addEventListener('click', togglePlayPause);
            document.getElementById('btn-prev').addEventListener('click', () => {
                // More than 5 seconds in — restart current track
                if (currentPosition > 5000) {
                    player?.seek(0);
                    return;
                }
                // History contains the currently playing song at [0].
                // We need at least 2 entries to go "back" (current + one before it).
                if (historyStack.length < 2) {
                    player?.seek(0);
                    return;
                }

                // Pop current song off the top — it's the one playing now
                historyStack.shift();
                // The new top is what we want to go back to
                const prev = historyStack[0];
                // console.log(`[history] back → "${prev.name}" — remaining: [${historyStack.map(s => s.name).join(', ')}]`);

                // Put current song at front of manual queue so pressing next returns to it
                if (nowPlayingSong) {
                    // console.log(`[history] prepending "${nowPlayingSong.name}" to manual queue`);
                    socket.emit('queue-prepend', { roomId, song: { ...nowPlayingSong } });
                }

                // skipHistoryPush=true — prev is already at historyStack[0], don't re-add it
                appTriggeredUri = prev.uri;
                lastAdvancedUri = currentTrackUri;
                playSong(prev.uri, false, true);
            });
            document.getElementById('btn-next').addEventListener('click', () => {
                appTriggeredUri = currentTrackUri;
                lastAdvancedUri = currentTrackUri;
                socket.emit('queue-advance', { roomId });
            });
            // volume-slider removed from player bar in mobile redesign
            // progress-bar removed from player bar in mobile redesign (now lives in the np-modal)

            // ── Spotify Connect: device picker + polling fallback ─────────────────────
            //
            // When the host transfers playback to another device (phone app, desktop,
            // etc.) and that device goes offline, the Web Playback SDK stops firing
            // player_state_changed, so queue advancement stalls. We fix this with a
            // polling fallback that watches GET /me/player every 3 s whenever the SDK
            // is not the active device.
            //
            // The Connect button opens a modal listing all active Spotify devices.
            // Selecting one calls PUT /me/player to transfer playback seamlessly.

            let pollingInterval    = null;
            let pollingLastUri     = null;
            let pollingLastPos     = 0;
            let sdkIsActiveDevice  = false; // true when SDK player is the active device
            let cachedPollingToken = null;  // reused across polls; cleared on 401

            function startPolling() {
                if (pollingInterval) return;
                console.log('[connect] starting playback polling (SDK not active device)');
                const pollingStatusEl = document.getElementById('connect-polling-status');
                if (pollingStatusEl) pollingStatusEl.textContent = '⚡ Polling mode';
                pollingInterval = setInterval(pollPlaybackState, 3000);
            }

            function stopPolling() {
                if (!pollingInterval) return;
                console.log('[connect] stopping playback polling (SDK reclaimed device)');
                const pollingStatusEl = document.getElementById('connect-polling-status');
                if (pollingStatusEl) pollingStatusEl.textContent = '';
                clearInterval(pollingInterval);
                pollingInterval = null;
            }

            async function pollPlaybackState() {
                // If the SDK has reclaimed the device, stop polling
                if (sdkIsActiveDevice) { stopPolling(); return; }
                try {
                    // Reuse cached token — only re-fetch if missing or last call returned 401
                    if (!cachedPollingToken) {
                        const res = await fetch('/spotify/token').then(r => r.json());
                        cachedPollingToken = res.accessToken;
                    }
                    if (!cachedPollingToken) return;

                    const stateRes = await fetch('https://api.spotify.com/v1/me/player', {
                        headers: { Authorization: `Bearer ${cachedPollingToken}` },
                    });

                    if (stateRes.status === 401) {
                        // Token expired — clear cache and retry next cycle
                        cachedPollingToken = null;
                        return;
                    }

                    // 204 = nothing playing; 200 = state available
                    if (stateRes.status === 204 || !stateRes.ok) return;

                    const state = await stateRes.json();
                    if (!state || !state.item) return;

                    const uri      = state.item.uri;
                    const pos      = state.progress_ms || 0;
                    const duration = state.item.duration_ms || 0;
                    const playing  = state.is_playing;

                    // Update progress bar even in polling mode
                    currentPosition = pos;
                    currentDuration = duration;
                    isPlaying       = playing;
                    updateProgress();
                    updatePlayPauseIcon();

                    // Update progress bar and broadcast now-playing if track changed.
                    // Queue advancement is handled server-side — no client queue-advance here.
                    if (uri !== pollingLastUri) {
                        pollingLastUri = uri;
                        const songData = {
                            name:   state.item.name,
                            artist: state.item.artists.map(a => a.name).join(', '),
                            image:  state.item.album?.images?.[0]?.url || '',
                            uri,
                        };
                        nowPlayingSong = songData;
                        updateNowPlaying(state.item);
                        renderQueue();
                        // Broadcast so server tracks now-playing and guests stay in sync
                        socket.emit('now-playing-broadcast', { roomId, song: songData });
                        console.log(`[poll] track changed: "${state.item.name}"`);
                    }
                } catch (e) {
                    console.warn('[connect] poll error:', e.message);
                }
            }

            const connectOverlay = document.getElementById('connect-modal-overlay');
            const connectBtn     = document.getElementById('btn-spotify-connect');
            const closeConnectBtn = document.getElementById('btn-close-connect-modal');
            const refreshBtn     = document.getElementById('btn-refresh-devices');

            function openConnectModal() {
                connectOverlay.style.display = 'flex';
                loadDevices();
            }
            function closeConnectModal() {
                connectOverlay.style.display = 'none';
            }

            connectBtn?.addEventListener('click', openConnectModal);
            // Also wire the header Connect button (same functionality)
            const connectBtnHeader = document.getElementById('btn-spotify-connect-header');
            if (connectBtnHeader) connectBtnHeader.addEventListener('click', openConnectModal);
            closeConnectBtn.addEventListener('click', closeConnectModal);
