                    <div style="padding:48px 0;text-align:center;color:var(--muted);font-size:0.8rem;">Loading tracks...</div>`;

                try {
                    const res = await fetch(`/spotify/playlists/${sourceId}/tracks`);
                    if (!res.ok) {
                        const body = await res.json().catch(() => ({}));
                        if (res.status === 403) {
                            forbiddenPlaylists.add(sourceId);
                            document.querySelector(`.source-item[data-source="${sourceId}"]`)?.remove();
                            switchSource('liked', 'Liked Songs');
                        } else {
