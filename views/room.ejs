                const mArtist = document.getElementById('guest-np-modal-artist');
                if (mArtist) mArtist.textContent = song.artist || '';

                // Reset guest progress bar — caller sets guestCurrentDuration/Position after this
                guestCurrentPosition = song.progress_ms || 0;
                guestCurrentDuration = song.duration_ms || 0;
                updateGuestProgress();
            }

            // ── Guest progress ticker ─────────────────────────────────────────────────
            // Guests don't have SDK access so we fake progress by counting up from 0.
            // It resets whenever a new now-playing event arrives.
            let guestCurrentPosition = 0;
            let guestCurrentDuration = 0;
            let guestProgressInterval = null;

            function updateGuestProgress() {
                const pct = guestCurrentDuration > 0
                    ? Math.min((guestCurrentPosition / guestCurrentDuration) * 100, 100)
                    : 0;

                const barFill = document.getElementById('guest-bar-progress-fill');
                if (barFill) barFill.style.width = `${pct}%`;

                const mFill = document.getElementById('guest-np-modal-progress-fill');
                if (mFill) mFill.style.width = `${pct}%`;

                const mCur = document.getElementById('guest-np-modal-time-current');
                if (mCur) mCur.textContent = msToTime(guestCurrentPosition);
                const mTot = document.getElementById('guest-np-modal-time-total');
                if (mTot) mTot.textContent = guestCurrentDuration > 0 ? msToTime(guestCurrentDuration) : '—';
            }

            // Start ticking once music is playing
            function startGuestProgressTicker() {
                clearInterval(guestProgressInterval);
                guestProgressInterval = setInterval(() => {
                    guestCurrentPosition += 500;
                    if (guestCurrentDuration > 0 && guestCurrentPosition > guestCurrentDuration) {
                        guestCurrentPosition = guestCurrentDuration;
                    }
                    updateGuestProgress();
                }, 500);
