            function closeSidebar() {
                sidebar.classList.remove('open');
                sidebar.classList.add('collapsed');
                sidebar.style.pointerEvents = '';
                libToggle.classList.remove('active');
                backdrop.classList.remove('visible');
            }

            let playlistsLoaded = false;

            // Start collapsed on mobile. On desktop the sidebar's CSS default is
            // already visually open (only `.collapsed` hides it) - without this,
            // the JS class state stays out of sync with what's on screen and
            // playlists never fetch until the user happens to toggle the panel.
            if (window.innerWidth <= 768) {
                sidebar.classList.add('collapsed');
                libToggle.classList.remove('active');
            } else {
                openSidebar();
                playlistsLoaded = true;
                loadPlaylists();
            }

            libToggle.addEventListener('click', () => {
                if (sidebar.classList.contains('open')) {
                    closeSidebar();
                } else {
                    openSidebar();
                    if (!playlistsLoaded) { playlistsLoaded = true; loadPlaylists(); }
                }
            });
            backdrop.addEventListener('click', closeSidebar);

            // ── Swipe left to close library sidebar (mobile) ──────────────────────────
            (function initSidebarSwipe() {
                let swipeStartX = null;
                let swipeStartY = null;
                const SWIPE_H_THRESHOLD = 16;
                const SWIPE_V_LOCK      = 12;

                sidebar.addEventListener('touchstart', (e) => {
                    const btn = e.target.closest('button');
                    if (btn) { swipeStartX = null; return; }
                    const t = e.touches[0];
                    swipeStartX = t.clientX;
                    swipeStartY = t.clientY;
                    sidebar.style.transition = 'none';
                }, { passive: true });

                sidebar.addEventListener('touchmove', (e) => {
                    if (swipeStartX === null) return;
                    const t  = e.touches[0];
                    const dx = t.clientX - swipeStartX;
                    const dy = Math.abs(t.clientY - swipeStartY);
                    if (dy > SWIPE_V_LOCK && Math.abs(dx) < dy) { swipeStartX = null; sidebar.style.transform = ''; return; }
                    if (dx < 0) {
                        sidebar.style.transform = `translateX(${dx}px)`;
                    }
                }, { passive: true });

                sidebar.addEventListener('touchend', (e) => {
                    if (swipeStartX === null) return;
                    const dx = e.changedTouches[0].clientX - swipeStartX;
                    sidebar.style.transition = '';
                    sidebar.style.transform  = '';
                    if (dx < -SWIPE_H_THRESHOLD) closeSidebar();
                    swipeStartX = null;
                }, { passive: true });

                sidebar.addEventListener('touchcancel', () => {
                    swipeStartX = null;
                    sidebar.style.transition = '';
                    sidebar.style.transform  = '';
                }, { passive: true });
            })();

            // Switch source
            async function switchSource(sourceId, sourceName) {
                document.querySelectorAll('.source-item').forEach(el => {
                    el.classList.toggle('active', el.dataset.source === sourceId);
                });
                currentSource = sourceId;
                document.getElementById('source-title').textContent = sourceName;
                document.getElementById('search').value = '';
                document.getElementById('btn-search-clear').style.display = 'none';

                if (sourceId === 'liked') {
                    currentSongs = [...allSongs];
                    document.getElementById('count-label').textContent = `${allSongs.length} SONGS`;
                    renderSongs(currentSongs);
                    return;
                }

                if (playlistCache[sourceId]) {
                    currentSongs = playlistCache[sourceId];
                    document.getElementById('count-label').textContent = `${currentSongs.length} SONGS`;
                    renderSongs(currentSongs);
                    return;
                }

                document.getElementById('count-label').textContent = 'LOADING...';
                document.getElementById('song-list').innerHTML = `
                    <div style="padding:48px 0;text-align:center;color:var(--muted);font-size:0.8rem;">Loading tracks...</div>`;

                try {
                    const res = await fetch(`/spotify/playlists/${sourceId}/tracks`);
                    if (!res.ok) {
                        document.getElementById('count-label').textContent = 'UNAVAILABLE';
                        // Spotify returns 403 for playlists you follow but don't own or
                        // collaborate on - the API only allows reading tracks from your own
                        // or collaborative playlists, not arbitrary followed ones.
                        const message = res.status === 403
                            ? "Can't be loaded - Spotify only allows reading tracks from playlists you own or collaborate on"
                            : "This playlist can't be loaded";
                        document.getElementById('song-list').innerHTML = `
                            <div style="padding:48px 0;text-align:center;color:var(--muted);font-size:0.8rem;">
                                ${message}
                            </div>`;
                        return;
                    }
                    const songs = await res.json();
                    playlistCache[sourceId] = songs;
                    if (currentSource === sourceId) {
                        currentSongs = songs;
                        document.getElementById('count-label').textContent = `${songs.length} SONGS`;
                        renderSongs(currentSongs);
                    }
                } catch (e) {
                    document.getElementById('count-label').textContent = 'ERROR';
                }
            }

            document.getElementById('source-liked').addEventListener('click', () => switchSource('liked', 'Liked Songs'));

            // Load playlists
            async function loadPlaylists() {
                const container = document.getElementById('playlist-list');
                try {
                    const res  = await fetch('/spotify/playlists');
                    const data = await res.json();

                    if (!res.ok) {
                        const retryMsg = data.retryAfter ? ` (retry in ${data.retryAfter}s)` : '';
                        container.innerHTML = `<div style="padding:8px 14px;font-size:0.72rem;color:#e74c3c;font-style:italic;">
                            ${res.status === 429 ? `Rate limited by Spotify${retryMsg} — open the sidebar again in a moment` : (data.error || 'Failed to load')}
                            <br/><button onclick="playlistsLoaded=false;loadPlaylists()" style="margin-top:6px;background:none;border:1px solid var(--muted);color:var(--muted2);border-radius:4px;padding:3px 8px;cursor:pointer;font-size:0.68rem;">Retry</button>
                        </div>`;
                        return;
                    }

                    container.innerHTML = '';
                    if (data.length === 0) {
                        container.innerHTML = `<div style="padding:8px 14px;font-size:0.72rem;color:var(--muted);font-style:italic;">No playlists found</div>`;
                        return;
                    }
                    data.filter(pl => !pl.isSpotifyOwned).forEach(pl => {
                        const item = document.createElement('div');
                        item.className = 'source-item';
                        item.dataset.source = pl.id;
                        item.innerHTML = `
                            ${pl.image
                                ? `<img class="source-art" src="${pl.image}" alt="${pl.name}" />`
                                : `<div class="source-art-placeholder"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/></svg></div>`}
                            <div class="source-info"><div class="source-name">${pl.name}</div></div>
                        `;
                        item.addEventListener('click', () => switchSource(pl.id, pl.name));
                        container.appendChild(item);
                    });
                } catch (e) {
                    container.innerHTML = `<div style="padding:8px 14px;font-size:0.72rem;color:var(--muted);font-style:italic;">Failed to load</div>`;
                }

            }


            // ── Infinite scroll ───────────────────────────────────────────────────────
            async function loadMoreLikedSongs() {
                if (likedLoading || likedExhausted || currentSource !== 'liked') return;
                likedLoading = true;
                try {
                    const res = await fetch(`/spotify/liked?offset=${likedOffset}&limit=50`);
                    if (!res.ok) { likedLoading = false; return; }
                    const songs = await res.json();
                    if (songs.length === 0) {
                        likedExhausted = true;
                        document.getElementById('scroll-sentinel')?.remove();
                        likedLoading = false; return;
                    }
                    allSongs.push(...songs);
                    likedOffset += songs.length;
                    if (currentSource === 'liked') {
                        currentSongs = [...allSongs];
                        const list  = document.getElementById('song-list');
                        const query = document.getElementById('search').value.trim();
                        if (!query) {
                            const startIdx = allSongs.length - songs.length;
                            songs.forEach((song, i) => {
                                const row = makeSongRow(song, startIdx + i);
                                list.insertBefore(row, document.getElementById('scroll-sentinel'));
                            });
                            document.getElementById('count-label').textContent = `${allSongs.length} SONGS`;
                        }
                    }
                } catch (e) {}
                likedLoading = false;
            }

            function attachScrollSentinel() {
                document.getElementById('scroll-sentinel')?.remove();
                const sentinel = document.createElement('div');
                sentinel.id = 'scroll-sentinel';
                sentinel.style.height = '1px';
                document.getElementById('song-list').appendChild(sentinel);
                const observer = new IntersectionObserver((entries) => {
                    if (entries[0].isIntersecting) loadMoreLikedSongs();
                }, { rootMargin: '200px' });
                observer.observe(sentinel);
            }

