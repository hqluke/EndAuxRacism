<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EndAuxRacism — Room</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #0a0a0a;
            --surface: #111111;
            --surface2: #1a1a1a;
            --surface3: #202020;
            --border: #222222;
            --green: #1db954;
            --green-dim: #1aa34a;
            --text: #f0f0f0;
            --muted: #555;
            --muted2: #888;
            --player-h: 88px;
            --drawer-w: 340px;
            --sidebar-w: 240px;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Mono', monospace;
            min-height: 100vh;
            padding-bottom: calc(var(--player-h) + 24px);
            overflow-x: hidden;
        }

        /* ── Header ── */
        header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 20px 32px; border-bottom: 1px solid var(--border);
            position: sticky; top: 0;
            background: rgba(10,10,10,0.92); backdrop-filter: blur(12px); z-index: 10;
            height: 73px;
        }

        .header-left { display: flex; align-items: center; gap: 14px; }

        .logo {
            font-family: 'Syne', sans-serif; font-weight: 800;
            font-size: 1.3rem; letter-spacing: -0.03em; color: var(--green);
            text-decoration: none;
        }

        .host-badge {
            background: rgba(29,185,84,0.12); border: 1px solid rgba(29,185,84,0.3);
            color: var(--green); border-radius: 100px;
            font-size: 0.65rem; letter-spacing: 0.06em; padding: 3px 10px;
        }

        .room-id-pill {
            display: flex; align-items: center; gap: 7px;
            background: var(--surface2); border: 1px solid var(--border);
            border-radius: 100px; padding: 4px 12px 4px 8px;
            font-size: 0.7rem; color: var(--muted2); cursor: pointer;
            transition: border-color 0.2s, color 0.2s;
        }
        .room-id-pill:hover { border-color: var(--green); color: var(--text); }

        .listener-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: var(--green); animation: pulse 2s infinite; flex-shrink: 0;
        }

        @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

        .header-right { display: flex; align-items: center; gap: 12px; }

        /* Sidebar toggle */
        #btn-library-toggle {
            background: none; border: 1px solid var(--border); border-radius: 8px;
            color: var(--muted2); cursor: pointer; padding: 6px 10px;
            font-family: 'DM Mono', monospace; font-size: 0.7rem;
            display: flex; align-items: center; gap: 6px;
            transition: all 0.15s; flex-shrink: 0;
        }
        #btn-library-toggle:hover { color: var(--text); border-color: var(--muted2); }
        #btn-library-toggle.active { color: var(--green); border-color: var(--green); }

        .user-pill {
            display: flex; align-items: center; gap: 8px;
            background: var(--surface2); border: 1px solid var(--border);
            border-radius: 100px; padding: 5px 14px 5px 5px;
        }
        .user-pill img, .avatar-placeholder { width: 26px; height: 26px; border-radius: 50%; }
        .user-pill img { object-fit: cover; }
        .avatar-placeholder {
            background: var(--green); display: flex; align-items: center;
            justify-content: center; font-size: 0.65rem; font-weight: 700; color: #000;
        }
        .user-pill span { font-size: 0.75rem; color: var(--muted2); }

        .btn-text {
            background: none; border: none; color: var(--muted); cursor: pointer;
            font-family: 'DM Mono', monospace; font-size: 0.72rem;
            letter-spacing: 0.04em; transition: color 0.2s; text-decoration: none;
        }
        .btn-text:hover { color: var(--text); }
        .btn-text.green { color: var(--green); }

        /* ── Layout ── */
        .layout { display: flex; min-height: calc(100vh - 73px); }

        /* ── Left Sidebar ── */
        #library-sidebar {
            width: var(--sidebar-w); flex-shrink: 0;
            background: var(--surface); border-right: 1px solid var(--border);
            display: flex; flex-direction: column;
            position: sticky; top: 73px;
            height: calc(100vh - 73px - var(--player-h));
            overflow: hidden;
            transition: width 0.3s cubic-bezier(0.4,0,0.2,1), opacity 0.3s;
        }
        #library-sidebar.collapsed { width: 0; opacity: 0; pointer-events: none; }

        .sidebar-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 16px 16px 12px; border-bottom: 1px solid var(--border); flex-shrink: 0;
        }
        .sidebar-title {
            font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.85rem;
        }

        .sidebar-body { flex: 1; overflow-y: auto; padding: 8px 0; }
        .sidebar-body::-webkit-scrollbar { width: 3px; }
        .sidebar-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        .sidebar-section-label {
            font-size: 0.6rem; letter-spacing: 0.12em; color: var(--muted);
            padding: 10px 14px 4px; text-transform: uppercase;
        }

        .source-item {
            display: flex; align-items: center; gap: 10px;
            padding: 8px 14px; cursor: pointer;
            border-radius: 6px; margin: 0 6px 2px;
            border: 1px solid transparent; transition: background 0.12s; min-width: 0;
        }
        .source-item:hover { background: var(--surface2); }
        .source-item.active { background: var(--surface2); border-color: var(--border); }
        .source-item.active .source-name { color: var(--green); }

        .source-art {
            width: 36px; height: 36px; border-radius: 4px;
            object-fit: cover; flex-shrink: 0;
            background: var(--surface2); border: 1px solid var(--border);
        }
        .source-art-placeholder {
            width: 36px; height: 36px; border-radius: 4px; flex-shrink: 0;
            background: var(--surface3); border: 1px solid var(--border);
            display: flex; align-items: center; justify-content: center; color: var(--muted);
        }
        .source-item.liked .source-art-placeholder {
            background: linear-gradient(135deg, #450af5, #c4efd9);
        }
        .source-info { overflow: hidden; flex: 1; min-width: 0; }
        .source-name {
            font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.78rem;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        /* ── Guest panel (non-Spotify users) ── */
        #guest-panel {
            flex: 1; min-width: 0; padding: 48px 32px 0;
        }

        .guest-welcome {
            max-width: 520px; margin: 0 auto;
        }

        .guest-welcome h1 {
            font-family: 'Syne', sans-serif; font-weight: 700;
            font-size: 1.6rem; letter-spacing: -0.02em; margin-bottom: 8px;
        }

        .guest-welcome p {
            font-size: 0.82rem; color: var(--muted2); margin-bottom: 32px; line-height: 1.7;
        }

        .import-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 12px; padding: 24px; margin-bottom: 16px;
        }

        .import-card-header {
            display: flex; align-items: center; gap: 10px; margin-bottom: 16px;
        }

        .import-card-icon {
            width: 36px; height: 36px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }

        .import-card-icon.apple { background: linear-gradient(135deg, #fc3c44, #ff6b6b); }

        .import-card-title {
            font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.95rem;
        }

        .import-card-sub { font-size: 0.7rem; color: var(--muted2); margin-top: 1px; }

        .import-row { display: flex; gap: 10px; }

        .import-input {
            flex: 1; background: var(--surface2); border: 1px solid var(--border);
            border-radius: 8px; color: var(--text); font-family: 'DM Mono', monospace;
            font-size: 0.78rem; padding: 9px 14px; outline: none; transition: border-color 0.2s;
        }
        .import-input::placeholder { color: var(--muted); }
        .import-input:focus { border-color: var(--green); }

        .btn-import {
            background: var(--green); color: #000; border: none; border-radius: 8px;
            font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.78rem;
            padding: 9px 18px; cursor: pointer; transition: background 0.2s; white-space: nowrap;
        }
        .btn-import:hover { background: var(--green-dim); }
        .btn-import:disabled { opacity: 0.5; cursor: not-allowed; }

        .import-note { font-size: 0.68rem; color: var(--muted); margin-top: 10px; line-height: 1.6; }

        .login-cta {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 12px; padding: 24px; text-align: center;
        }
        .login-cta p { font-size: 0.8rem; color: var(--muted2); margin-bottom: 16px; line-height: 1.6; }
        .btn-spotify-login {
            display: inline-flex; align-items: center; gap: 8px;
            background: var(--green); color: #000;
            font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.82rem;
            text-decoration: none; padding: 10px 22px; border-radius: 100px;
            transition: background 0.2s;
        }
        .btn-spotify-login:hover { background: var(--green-dim); }

        /* ── Main (Spotify users) ── */
        main {
            flex: 1; min-width: 0; padding: 48px 32px 0;
            transition: margin-right 0.35s cubic-bezier(0.4,0,0.2,1);
        }
        body.drawer-open main,
        body.drawer-open #guest-panel { margin-right: var(--drawer-w); }

        .section-header {
            display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px;
        }
        .header-title-group { display: flex; align-items: baseline; gap: 12px; }
        .header-title-group h1 {
            font-family: 'Syne', sans-serif; font-weight: 700;
            font-size: 1.6rem; letter-spacing: -0.02em;
        }
        .count { font-size: 0.75rem; color: var(--muted); letter-spacing: 0.08em; }

        /* ── Search ── */
        .search-wrap { position: relative; display: flex; align-items: center; }
        .search-wrap svg { position: absolute; left: 10px; color: var(--muted); pointer-events: none; }
        #search {
            background: var(--surface2); border: 1px solid var(--border); border-radius: 8px;
            color: var(--text); font-family: 'DM Mono', monospace; font-size: 0.78rem;
            padding: 7px 12px 7px 32px; outline: none; width: 200px;
            transition: border-color 0.2s, width 0.3s;
        }
        #search::placeholder { color: var(--muted); }
        #search:focus { border-color: var(--green); width: 260px; }

        /* ── Song List ── */
        .song-list { display: flex; flex-direction: column; gap: 2px; }

        .song-row {
            display: grid;
            grid-template-columns: 32px 48px 1fr auto;
            align-items: center; gap: 16px; padding: 10px 16px;
            border-radius: 8px; border: 1px solid transparent;
            transition: background 0.15s; animation: fadeUp 0.4s ease both;
        }
        .song-row:hover { background: var(--surface2); border-color: var(--border); }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .song-index { font-size: 0.75rem; color: var(--muted); text-align: center; }
        .song-art { width: 48px; height: 48px; border-radius: 4px; object-fit: cover; }
        .song-art-placeholder { width: 48px; height: 48px; border-radius: 4px; background: var(--surface2); border: 1px solid var(--border); }
        .song-info { overflow: hidden; }
        .song-name {
            font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.9rem;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .song-artist { font-size: 0.75rem; color: var(--muted2); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .row-actions { display: flex; gap: 6px; opacity: 0; transition: opacity 0.15s; }
        .song-row:hover .row-actions { opacity: 1; }

        .btn-play, .btn-queue {
            border: none; border-radius: 6px; cursor: pointer;
            font-family: 'DM Mono', monospace; font-size: 0.65rem;
            padding: 5px 8px; transition: background 0.15s, transform 0.1s;
        }
        .btn-play { background: var(--green); color: #000; font-weight: 600; }
        .btn-play:hover { background: var(--green-dim); transform: scale(1.05); }
        .btn-queue { background: var(--surface); color: var(--muted2); border: 1px solid var(--border); }
        .btn-queue:hover { color: var(--text); border-color: var(--muted2); }

        .match { color: var(--green); }
        .no-results { text-align: center; padding: 48px 0; color: var(--muted); font-size: 0.8rem; display: none; }

        /* ── Player Bar ── */
        #player-bar {
            position: fixed; bottom: 0; left: 0; right: 0;
            height: var(--player-h);
            background: rgba(15,15,15,0.97); border-top: 1px solid var(--border);
            backdrop-filter: blur(16px);
            display: flex; align-items: center; padding: 0 32px; gap: 24px; z-index: 100;
            transition: right 0.35s cubic-bezier(0.4,0,0.2,1);
        }
        body.drawer-open #player-bar { right: var(--drawer-w); }

        .now-playing { display: flex; align-items: center; gap: 12px; width: 220px; min-width: 0; }
        #np-art { width: 48px; height: 48px; border-radius: 4px; object-fit: cover; background: var(--surface2); flex-shrink: 0; }
        .np-text { overflow: hidden; }
        #np-name { font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        #np-artist { font-size: 0.7rem; color: var(--muted2); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .player-controls { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; }
        .control-btns { display: flex; align-items: center; gap: 20px; }

        .ctrl-btn {
            background: none; border: none; color: var(--muted2); cursor: pointer;
            padding: 4px; transition: color 0.15s, transform 0.1s; display: flex; align-items: center;
        }
        .ctrl-btn:hover { color: var(--text); transform: scale(1.1); }

        #btn-play-pause {
            width: 36px; height: 36px; border-radius: 50%;
            background: var(--text); color: #000;
            display: flex; align-items: center; justify-content: center;
            transition: background 0.15s, transform 0.1s;
        }
        #btn-play-pause:hover { background: var(--green); transform: scale(1.08); }

        .progress-wrap { display: flex; align-items: center; gap: 10px; width: 100%; max-width: 480px; }
        .time-label { font-size: 0.65rem; color: var(--muted); width: 32px; }
        .time-label.right { text-align: right; }

        #progress-bar { flex: 1; height: 4px; background: var(--surface2); border-radius: 2px; cursor: pointer; position: relative; }
        #progress-fill { height: 100%; background: var(--green); border-radius: 2px; width: 0%; transition: width 0.5s linear; pointer-events: none; }

        .volume-wrap { display: flex; align-items: center; gap: 8px; width: 120px; }
        .volume-wrap svg { color: var(--muted2); flex-shrink: 0; }
        #volume-slider { -webkit-appearance: none; appearance: none; flex: 1; height: 4px; background: var(--surface2); border-radius: 2px; outline: none; cursor: pointer; }
        #volume-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 12px; height: 12px; border-radius: 50%; background: var(--text); cursor: pointer; }

        #sdk-status { font-size: 0.65rem; color: var(--muted); white-space: nowrap; }
        #sdk-status.ready { color: var(--green); }
        #sdk-status.error { color: #e74c3c; }

        /* Guest bar */
        #guest-bar {
            position: fixed; bottom: 0; left: 0; right: 0; height: var(--player-h);
            background: rgba(15,15,15,0.97); border-top: 1px solid var(--border);
            backdrop-filter: blur(16px);
            display: flex; align-items: center; padding: 0 32px; gap: 24px; z-index: 100;
            transition: right 0.35s cubic-bezier(0.4,0,0.2,1);
        }
        body.drawer-open #guest-bar { right: var(--drawer-w); }

        #guest-np { display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1; }
        #guest-np-art { width: 48px; height: 48px; border-radius: 4px; object-fit: cover; background: var(--surface2); flex-shrink: 0; opacity: 0; }
        #guest-np-name { font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--muted); }
        #guest-np-artist { font-size: 0.7rem; color: var(--muted2); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        /* Queue toggle */
        #btn-queue-toggle {
            background: none; border: 1px solid var(--border); border-radius: 8px;
            color: var(--muted2); cursor: pointer; padding: 6px 10px;
            font-family: 'DM Mono', monospace; font-size: 0.7rem;
            display: flex; align-items: center; gap: 6px; transition: all 0.15s; flex-shrink: 0;
        }
        #btn-queue-toggle:hover { color: var(--text); border-color: var(--muted2); }
        #btn-queue-toggle.active { color: var(--green); border-color: var(--green); }

        /* ── Queue Drawer ── */
        #queue-drawer {
            position: fixed; top: 0; right: 0; bottom: var(--player-h);
            width: var(--drawer-w); background: var(--surface); border-left: 1px solid var(--border);
            display: flex; flex-direction: column;
            transform: translateX(100%);
            transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
            z-index: 90; overflow: hidden;
        }
        #queue-drawer.open { transform: translateX(0); }

        .drawer-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 20px 20px 16px; border-bottom: 1px solid var(--border); flex-shrink: 0;
        }
        .drawer-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1rem; }

        #btn-close-drawer { background: none; border: none; color: var(--muted2); cursor: pointer; padding: 4px; transition: color 0.15s; }
        #btn-close-drawer:hover { color: var(--text); }

        .drawer-body { flex: 1; overflow-y: auto; padding: 12px 0; }
        .drawer-body::-webkit-scrollbar { width: 4px; }
        .drawer-body::-webkit-scrollbar-track { background: transparent; }
        .drawer-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        .queue-section-label {
            font-size: 0.65rem; letter-spacing: 0.1em; color: var(--muted);
            padding: 8px 20px 6px; text-transform: uppercase;
        }
        .queue-empty-hint { font-size: 0.75rem; color: var(--muted); padding: 8px 20px; font-style: italic; }

        .queue-item {
            display: grid; grid-template-columns: 20px 36px 1fr 24px;
            align-items: center; gap: 10px; padding: 8px 20px; cursor: grab;
            border: 1px solid transparent; border-radius: 6px; margin: 0 8px 2px;
            transition: background 0.12s; touch-action: none; user-select: none;
        }
        .queue-item:hover { background: var(--surface2); border-color: var(--border); }
        .queue-item.dragging { opacity: 0.4; }
        .queue-item.drag-over { border-color: var(--green) !important; background: rgba(29,185,84,0.07); }

        .drag-handle { color: var(--muted); display: flex; align-items: center; cursor: grab; }
        .q-art { width: 36px; height: 36px; border-radius: 3px; object-fit: cover; }
        .q-art-placeholder { width: 36px; height: 36px; border-radius: 3px; background: var(--surface2); border: 1px solid var(--border); }
        .q-info { overflow: hidden; }
        .q-name { font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .q-artist { font-size: 0.68rem; color: var(--muted2); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        .btn-remove-queue {
            background: none; border: none; color: var(--muted); cursor: pointer;
            padding: 2px; opacity: 0; transition: opacity 0.15s, color 0.15s; display: flex; align-items: center;
        }
        .queue-item:hover .btn-remove-queue { opacity: 1; }
        .btn-remove-queue:hover { color: #e74c3c; }

        .now-playing-row {
            display: grid; grid-template-columns: 20px 36px 1fr;
            align-items: center; gap: 10px; padding: 8px 20px; margin: 0 8px 2px;
            border-radius: 6px; background: rgba(29,185,84,0.08); border: 1px solid rgba(29,185,84,0.2);
        }
        .now-playing-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); animation: blink 1.5s infinite; }
        @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }

        /* Mobile */
        @media (max-width: 600px) {
            :root { --drawer-w: 100vw; --sidebar-w: 100vw; }
            header { padding: 16px 20px; }
            main, #guest-panel { padding: 24px 12px 0; }
            #library-sidebar {
                position: fixed; top: 73px; left: 0; z-index: 80;
                height: calc(100vh - 73px - var(--player-h));
                transform: translateX(-100%);
                transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
            }
            #library-sidebar:not(.collapsed) { transform: translateX(0); }
            .volume-wrap { display: none; }
        }
    </style>
</head>
<body>

<header>
    <div class="header-left">
        <a href="/spotify/dashboard" class="logo">EndAuxRacism</a>
        <% if (isHost) { %><span class="host-badge">HOST</span><% } %>
        <div class="room-id-pill" id="copy-room-link" title="Copy invite link">
            <div class="listener-dot"></div>
            <span id="listener-label">1 listener</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left:4px;color:var(--muted);">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
        </div>
    </div>

    <div class="header-right">
        <% if (user) { %>
            <button id="btn-library-toggle" class="active" title="Toggle library">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/>
                </svg>
                Library
            </button>
            <div class="user-pill">
                <% if (user.avatar) { %>
                    <img src="<%= user.avatar %>" alt="<%= user.displayName %>" />
                <% } else { %>
                    <div class="avatar-placeholder"><%= user.displayName?.charAt(0).toUpperCase() %></div>
                <% } %>
                <span><%= user.displayName %></span>
            </div>
            <a href="/logout" class="btn-text">log out</a>
        <% } else { %>
            <a href="/auth/spotify" class="btn-text green">login with spotify</a>
        <% } %>
    </div>
</header>

<div class="layout">

