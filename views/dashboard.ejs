<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>EndAuxRacism — Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/rooms.css" />
    <link rel="stylesheet" href="/dashboard.css" />
</head>
<body>

<header>
    <div class="header-left">
        <a href="/spotify/dashboard" class="logo">EndAuxRacism</a>
    </div>
    <div class="header-right">
        <button id="btn-library-toggle" class="active" title="Toggle library">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/>
            </svg>
            Library
        </button>
        <div class="user-pill">
            <% if (user.avatar) { %>
                <img src="<%= user.avatar %>" alt="<%= user.displayName %>" />
            <% } else { %>
                <div class="avatar-placeholder"><%= user.displayName?.charAt(0).toUpperCase() %></div>
            <% } %>
            <span><%= user.displayName %></span>
        </div>
        <a href="/rooms/<%= user.id %>" class="btn-start-room">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/>
            </svg>
            Start Room
        </a>
        <a href="/logout" class="btn-text">log out</a>
    </div>
</header>

<!-- Sidebar backdrop (mobile only) -->
<div id="sidebar-backdrop"></div>

<div class="layout">

<!-- ── Library Sidebar ── -->
<div id="library-sidebar">
    <div class="sidebar-header">
        <span class="sidebar-title">Library</span>
    </div>
    <div class="sidebar-body" id="sidebar-body">
        <div class="sidebar-section-label">Songs</div>
        <div class="source-item liked active" id="source-liked" data-source="liked">
            <div class="source-art-placeholder">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
            </div>
            <div class="source-info">
                <div class="source-name">Liked Songs</div>
            </div>
        </div>
        <div class="sidebar-section-label">Playlists</div>
        <div id="playlist-list">
            <div style="padding:8px 14px;font-size:0.72rem;color:var(--muted);font-style:italic;">Loading...</div>
        </div>
    </div>
</div>

<main>
    <% if (songs && songs.length > 0) { %>

    <div class="section-header">
        <div class="header-title-group">
            <h1 id="source-title">Liked Songs</h1>
            <span class="count" id="count-label">LAST 50 ADDED</span>
        </div>
    </div>
    <div class="search-row">
        <div class="search-wrap">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input id="search" type="text" placeholder="search songs..." autocomplete="off" />
        </div>
        <button class="btn-search-clear" id="btn-search-clear" style="display:none;" title="Clear search">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
        </button>
    </div>

    <div id="sdk-status" style="font-size:0.65rem;color:var(--muted);margin-bottom:16px;">Connecting to Spotify player...</div>
    <div class="song-list" id="song-list"></div>
    <div class="no-results" id="no-results">no matches found</div>

    <% } else { %>
    <div class="empty">
        <h2>No liked songs found</h2>
        <p>Go like some songs on Spotify and come back.</p>
    </div>
    <% } %>
</main>

</div><!-- /.layout -->

<!-- ── Queue Drawer ── -->
<div id="queue-drawer">
    <div class="drawer-header">
        <span class="drawer-title">Queue</span>
        <button id="btn-close-drawer" title="Close queue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
        </button>
    </div>
    <div class="drawer-body" id="drawer-body"></div>
</div>

<!-- ── Player Bar ── -->
<div id="player-bar">
    <div class="now-playing">
        <img id="np-art" src="" alt="" style="opacity:0;" />
        <div class="np-text">
            <div id="np-name" style="color:var(--muted);">Not playing</div>
            <div id="np-artist"></div>
        </div>
    </div>
    <div class="player-controls">
        <div class="control-btns">
            <button class="ctrl-btn" id="btn-prev" title="Previous">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/></svg>
            </button>
            <button class="ctrl-btn" id="btn-play-pause" title="Play/Pause">
                <svg id="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                <svg id="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <button class="ctrl-btn" id="btn-next" title="Next">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="m6 18 8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
            </button>
        </div>
        <div class="progress-wrap">
            <span class="time-label" id="time-current">0:00</span>
            <div id="progress-bar"><div id="progress-fill"></div></div>
            <span class="time-label right" id="time-total">0:00</span>
        </div>
    </div>
    <div class="volume-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/>
        </svg>
        <input type="range" id="volume-slider" min="0" max="100" value="80" />
    </div>
    <div class="player-bar-right">
        <button id="btn-queue-toggle" title="Toggle queue">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>
            </svg>
            Queue
        </button>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="https://sdk.scdn.co/spotify-player.js"></script>
<script>
    // ── Song data & room ──────────────────────────────────────────────────────
    const allSongs = <%- JSON.stringify(songs) %>;
    const roomId = 'default-room';

    // ── State ─────────────────────────────────────────────────────────────────
    let deviceId        = null;
    let player          = null;
    let currentTrackUri = null;
    let nowPlayingSong  = null;
    let isPlaying       = false;
    let progressInterval = null;
    let currentPosition = 0;
    let currentDuration = 0;
    let lastAdvancedUri = null;

    let manualQueue  = [];
    let autoQueue    = [];
    let isDragging   = false;
    let historyStack = []; // up to 10 previously played songs

    let likedOffset    = allSongs.length;
    let likedLoading   = false;
    let likedExhausted = false;
    let autoQueueOffset = 50;

    let currentSource = 'liked';
    let currentSongs  = [...allSongs];
    let playlistCache = {};
    const forbiddenPlaylists = new Set();

    // ── Socket.io ─────────────────────────────────────────────────────────────
    const socket = io();

    socket.on('connect', () => {
        // console.log('[queue] socket connected, joining room:', roomId);
        socket.emit('join-room', roomId);
    });

    socket.on('queue-state', ({ manualQueue: mq, autoQueue: aq }) => {
        if (isDragging) return;
        manualQueue = mq;
        autoQueue   = aq;
        renderQueue();
    });

    socket.on('play-track', (song) => {
        currentTrackUri = song.uri;
        nowPlayingSong  = song;
        renderQueue();
        playSong(song.uri, false);
    });

    // ── Queue Drawer Toggle ───────────────────────────────────────────────────
    const drawer    = document.getElementById('queue-drawer');
    const toggleBtn = document.getElementById('btn-queue-toggle');
    const closeBtn  = document.getElementById('btn-close-drawer');

    function openDrawer()  { drawer.classList.add('open'); document.body.classList.add('drawer-open'); toggleBtn.classList.add('active'); }
    function closeDrawer() { drawer.classList.remove('open'); document.body.classList.remove('drawer-open'); toggleBtn.classList.remove('active'); }

    toggleBtn.addEventListener('click', () => drawer.classList.contains('open') ? closeDrawer() : openDrawer());
    closeBtn.addEventListener('click', closeDrawer);

    // ── Library Sidebar Toggle ────────────────────────────────────────────────
    const sidebar   = document.getElementById('library-sidebar');
    const libToggle = document.getElementById('btn-library-toggle');
    const backdrop  = document.getElementById('sidebar-backdrop');

    if (window.innerWidth <= 768) {
        sidebar.classList.add('collapsed');
        libToggle.classList.remove('active');
    }

    function openSidebar() {
        sidebar.classList.remove('collapsed');
        sidebar.classList.add('open');
        sidebar.style.pointerEvents = 'auto';
        libToggle.classList.add('active');
        if (window.innerWidth <= 768) backdrop.classList.add('visible');
    }
    function closeSidebar() {
        sidebar.classList.remove('open');
        sidebar.classList.add('collapsed');
        sidebar.style.pointerEvents = '';
        libToggle.classList.remove('active');
        backdrop.classList.remove('visible');
    }

    let playlistsLoaded = false;
    libToggle.addEventListener('click', () => {
        if (sidebar.classList.contains('open')) {
            closeSidebar();
        } else {
            openSidebar();
            if (!playlistsLoaded) { playlistsLoaded = true; loadPlaylists(); }
        }
    });
    backdrop.addEventListener('click', closeSidebar);

    // ── Spotify Web Playback SDK ──────────────────────────────────────────────
    window.onSpotifyWebPlaybackSDKReady = async () => {
        player = new Spotify.Player({
            name: 'EndAuxRacism Player',
            getOAuthToken: async (cb) => {
                const data = await fetch('/spotify/token').then(r => r.json());
                cb(data.accessToken);
            },
            volume: 0.8,
        });

        player.addListener('ready', ({ device_id }) => {
            deviceId = device_id;
            setStatus('ready', '● Player ready');
        });

        player.addListener('not_ready', () => setStatus('error', '✕ Disconnected'));

        player.addListener('player_state_changed', (state) => {
            if (!state) return;
            const track   = state.track_window.current_track;
            const prevUri = currentTrackUri;
            isPlaying       = !state.paused;
            currentPosition = state.position;
            currentDuration = state.duration;
            currentTrackUri = track.uri;

            updateNowPlaying(track);
            updatePlayPauseIcon();
            updateProgress();

            const songData = {
                name:   track.name,
                artist: track.artists.map(a => a.name).join(', '),
                image:  track.album?.images?.[0]?.url || '',
                uri:    track.uri,
            };

            if (prevUri !== track.uri) {
                nowPlayingSong = songData;
                renderQueue();
                // console.log(`[player] track changed: "${track.name}"`);
            }

            clearInterval(progressInterval);
            if (isPlaying) {
                progressInterval = setInterval(() => {
                    currentPosition += 500;
                    updateProgress();
                    // Near-end advance
                    if (
                        currentDuration > 0 &&
                        currentPosition >= currentDuration - 3000 &&
                        lastAdvancedUri !== currentTrackUri
                    ) {
                        lastAdvancedUri = currentTrackUri;
                        // console.log(`[player] near end of "${track.name}" — advancing queue`);
                        socket.emit('queue-advance', { roomId });
                    }
                }, 500);
            }

            if (autoQueue.length < 10) fetchMoreSongs();
        });

        player.addListener('initialization_error', ({ message }) => setStatus('error', `Init: ${message}`));
        player.addListener('authentication_error',  ({ message }) => setStatus('error', `Auth: ${message}`));
        player.addListener('account_error',         ()           => setStatus('error', 'Premium required'));

        player.connect();
    };

    // ── Controls ──────────────────────────────────────────────────────────────
    document.getElementById('btn-play-pause').addEventListener('click', () => player?.togglePlay());
    document.getElementById('btn-prev').addEventListener('click', () => {
        // More than 5 seconds in — restart current track
        if (currentPosition > 5000) {
            player?.seek(0);
            return;
        }
        // Need at least 2 entries — current song is at [0], previous is at [1]
        if (historyStack.length < 2) {
            player?.seek(0);
            return;
        }

        // Pop current song off the top
        historyStack.shift();
        const prev = historyStack[0];
        // console.log(`[history] back → "${prev.name}" — remaining: [${historyStack.map(s => s.name).join(', ')}]`);

        // Put current song at front of manual queue so pressing next returns to it
        if (nowPlayingSong) {
            // console.log(`[history] prepending "${nowPlayingSong.name}" to manual queue`);
            socket.emit('queue-prepend', { roomId, song: { ...nowPlayingSong } });
        }

        // skipHistoryPush=true — prev is already at historyStack[0], don't re-add it
        lastAdvancedUri = currentTrackUri;
        playSong(prev.uri, false, true);
    });
    document.getElementById('btn-next').addEventListener('click', () => {
        lastAdvancedUri = currentTrackUri;
        socket.emit('queue-advance', { roomId });
    });
    document.getElementById('volume-slider').addEventListener('input', (e) => player?.setVolume(e.target.value / 100));
    document.getElementById('progress-bar').addEventListener('click', (e) => {
        if (!player || !currentDuration) return;
        const rect   = e.currentTarget.getBoundingClientRect();
        const seekTo = Math.floor(((e.clientX - rect.left) / rect.width) * currentDuration);
        player.seek(seekTo); currentPosition = seekTo; updateProgress();
    });

    // ── Play a track ──────────────────────────────────────────────────────────
    async function playSong(trackUri, setAutoFromHere = true, skipHistoryPush = false) {
        if (!deviceId) return alert('Player not ready yet');
        // console.log(`[player] playSong "${trackUri}" setAuto=${setAutoFromHere}`);

        // Push the INCOMING song to history immediately when it starts playing
        if (!skipHistoryPush) {
            const incoming = [...manualQueue, ...autoQueue, ...currentSongs].find(s => s.uri === trackUri)
                          || (nowPlayingSong?.uri === trackUri ? nowPlayingSong : null);
            if (incoming && historyStack[0]?.uri !== trackUri) {
                historyStack.unshift({ ...incoming });
                if (historyStack.length > 10) historyStack.pop();
                // console.log(`[history] pushed "${incoming.name}" — stack: [${historyStack.map(s => s.name).join(', ')}]`);
            }
        }

        await fetch('/spotify/play', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ trackUri, deviceId }),
        });
        // Do NOT set currentTrackUri here — player_state_changed owns it
        if (nowPlayingSong?.uri !== trackUri) {
            const known = [...manualQueue, ...autoQueue, ...currentSongs].find(s => s.uri === trackUri);
            if (known) { nowPlayingSong = known; renderQueue(); }
        }
        if (setAutoFromHere) {
            const idx   = currentSongs.findIndex(s => s.uri === trackUri);
            const after = idx >= 0 ? currentSongs.slice(idx + 1) : currentSongs;
            socket.emit('queue-set-auto', { roomId, songs: after.slice(0, 30) });
        }
    }

    function queueSong(song) {
        socket.emit('queue-add', { roomId, song });
        showToast(`"${song.name}" added to queue`);
    }

    async function fetchMoreSongs() {
        try {
            const res   = await fetch(`/spotify/liked?offset=${autoQueueOffset}&limit=20`);
            if (!res.ok) return;
            const songs = await res.json();
            if (songs.length > 0) {
                autoQueueOffset += songs.length;
                socket.emit('queue-replenish', { roomId, songs });
            }
        } catch (e) {}
    }

    // ── Render Queue Drawer ───────────────────────────────────────────────────
    function renderQueue() {
        const body = document.getElementById('drawer-body');
        body.innerHTML = '';

        if (currentTrackUri && nowPlayingSong) {
            const label = document.createElement('div');
            label.className = 'queue-section-label';
            label.textContent = 'Now Playing';
            body.appendChild(label);
            const row = document.createElement('div');
            row.className = 'now-playing-row';
            row.innerHTML = `
                <div class="now-playing-dot"></div>
                ${nowPlayingSong.image ? `<img class="q-art" src="${nowPlayingSong.image}" />` : `<div class="q-art-placeholder"></div>`}
                <div class="q-info">
                    <div class="q-name">${nowPlayingSong.name || ''}</div>
                    <div class="q-artist">${nowPlayingSong.artist || ''}</div>
                </div>`;
            body.appendChild(row);
        }

        const manLabel = document.createElement('div');
        manLabel.className = 'queue-section-label';
        manLabel.textContent = `Next Up (${manualQueue.length})`;
        body.appendChild(manLabel);

        if (manualQueue.length === 0) {
            const hint = document.createElement('div');
            hint.className = 'queue-empty-hint';
            hint.textContent = 'No queued songs — use + queue to add';
            body.appendChild(hint);
        } else {
            manualQueue.forEach((song, i) => body.appendChild(makeQueueItem(song, i, 'manual')));
        }

        const autoLabel = document.createElement('div');
        autoLabel.className = 'queue-section-label';
        autoLabel.style.marginTop = '12px';
        autoLabel.textContent = `Up Next (${autoQueue.length})`;
        body.appendChild(autoLabel);

        if (autoQueue.length === 0) {
            const hint = document.createElement('div');
            hint.className = 'queue-empty-hint';
            hint.textContent = 'Will populate when you press play';
            body.appendChild(hint);
        } else {
            autoQueue.forEach((song, i) => body.appendChild(makeQueueItem(song, i, 'auto')));
        }
    }

    function makeQueueItem(song, index, queueType) {
        const item = document.createElement('div');
        item.className = 'queue-item';
        item.dataset.index     = index;
        item.dataset.queueType = queueType;
        item.innerHTML = `
            <button class="btn-remove-queue" title="Remove">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M18 6 6 18M6 6l12 12"/>
                </svg>
            </button>
            ${song.image
                ? `<img class="q-art" src="${song.image}" alt="" draggable="false" />`
                : `<div class="q-art-placeholder"></div>`}
            <div class="q-info">
                <div class="q-name">${song.name}</div>
                <div class="q-artist">${song.artist}</div>
            </div>
            <div class="drag-handle" draggable="true" title="Drag to reorder">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" opacity="0.5">
                    <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
                </svg>
            </div>`;
        item.querySelector('.btn-remove-queue').addEventListener('click', (e) => {
            e.stopPropagation();
            socket.emit('queue-remove', { roomId, queueType: item.dataset.queueType, index: parseInt(item.dataset.index) });
        });
        return item;
    }

    // ── Drag & drop (mouse + touch) ───────────────────────────────────────────
    let dragSrc = null, dragOverItem = null;

    function reorderQueue(queueType, fromIndex, toIndex) {
        if (fromIndex === toIndex) return;
        const arr  = queueType === 'manual' ? manualQueue : autoQueue;
        const copy = [...arr];
        const [moved] = copy.splice(fromIndex, 1);
        copy.splice(toIndex, 0, moved);
        if (queueType === 'manual') manualQueue = copy; else autoQueue = copy;
        renderQueue();
        socket.emit('queue-reorder', { roomId, queueType, fromIndex, toIndex });
    }

    function moveToManualQueue(fromAutoIndex, toManualIndex) {
        const autoCopy   = [...autoQueue];
        const manualCopy = [...manualQueue];
        const [moved] = autoCopy.splice(fromAutoIndex, 1);
        const insertAt = manualCopy.length === 0 ? 0 : toManualIndex;
        manualCopy.splice(insertAt, 0, moved);
        autoQueue = autoCopy; manualQueue = manualCopy;
        renderQueue();
        socket.emit('queue-move-to-manual', { roomId, fromAutoIndex, toManualIndex: insertAt });
    }

    function commitDrop(srcEl, targetEl) {
        if (!targetEl || !srcEl || targetEl === srcEl) return;
        document.querySelectorAll('.queue-item.drag-over').forEach(el => el.classList.remove('drag-over'));
        const fromIndex = parseInt(srcEl.dataset.index);
        const fromType  = srcEl.dataset.queueType;
        const toIndex   = parseInt(targetEl.dataset.index);
        const toType    = targetEl.dataset.queueType;
        if (fromType !== toType) {
            if (fromType === 'auto' && toType === 'manual') moveToManualQueue(fromIndex, toIndex);
            return;
        }
        reorderQueue(fromType, fromIndex, toIndex);
    }

    (function initDrag() {
        const body = document.getElementById('drawer-body');

        // Mouse
        body.addEventListener('dragstart', (e) => {
            const handle = e.target.closest('.drag-handle');
            if (!handle) { e.preventDefault(); return; }
            const item = handle.closest('.queue-item');
            if (!item) return;
            dragSrc = item; isDragging = true;
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', '');
            setTimeout(() => item.classList.add('dragging'), 0);
        });
        body.addEventListener('dragend', () => {
            document.querySelectorAll('.queue-item.dragging').forEach(el => el.classList.remove('dragging'));
            document.querySelectorAll('.queue-item.drag-over').forEach(el => el.classList.remove('drag-over'));
            dragSrc = null; dragOverItem = null; isDragging = false;
        });
        body.addEventListener('dragover', (e) => {
            e.preventDefault();
            const item = e.target.closest('.queue-item');
            if (!item || item === dragSrc) return;
            if (item !== dragOverItem) {
                dragOverItem?.classList.remove('drag-over');
                item.classList.add('drag-over');
                dragOverItem = item;
            }
        });
        body.addEventListener('dragleave', (e) => {
            const item = e.target.closest('.queue-item');
            if (!item || item.contains(e.relatedTarget)) return;
            item.classList.remove('drag-over');
            if (dragOverItem === item) dragOverItem = null;
        });
        body.addEventListener('drop', (e) => {
            e.preventDefault();
            const target = e.target.closest('.queue-item');
            isDragging = false;
            commitDrop(dragSrc, target);
            dragOverItem = null; dragSrc = null;
        });

        // Touch
        let touchClone = null, touchSrc = null, touchOffsetX = 0, touchOffsetY = 0;

        body.addEventListener('touchstart', (e) => {
            const handle = e.target.closest('.drag-handle');
            const item   = handle ? handle.closest('.queue-item') : null;
            if (!item) return;
            touchSrc = item; isDragging = true;
            const touch = e.touches[0];
            const rect  = item.getBoundingClientRect();
            touchOffsetX = touch.clientX - rect.left;
            touchOffsetY = touch.clientY - rect.top;
            touchClone = item.cloneNode(true);
            touchClone.style.cssText = `
                position:fixed;left:${rect.left}px;top:${rect.top}px;width:${rect.width}px;
                opacity:0.85;pointer-events:none;z-index:9999;
                background:var(--surface2);border:1px solid var(--green);
                border-radius:6px;box-shadow:0 8px 24px rgba(0,0,0,0.5);`;
            document.body.appendChild(touchClone);
            item.classList.add('dragging');
        }, { passive: false });

        body.addEventListener('touchmove', (e) => {
            if (!touchSrc || !touchClone) return;
            e.preventDefault();
            const touch = e.touches[0];
            touchClone.style.left = `${touch.clientX - touchOffsetX}px`;
            touchClone.style.top  = `${touch.clientY - touchOffsetY}px`;
            touchClone.style.display = 'none';
            const elUnder = document.elementFromPoint(touch.clientX, touch.clientY);
            touchClone.style.display = '';
            const overItem = elUnder?.closest('.queue-item');
            if (overItem && overItem !== touchSrc) {
                if (overItem !== dragOverItem) {
                    dragOverItem?.classList.remove('drag-over');
                    overItem.classList.add('drag-over');
                    dragOverItem = overItem;
                }
            } else if (!overItem) {
                dragOverItem?.classList.remove('drag-over');
                dragOverItem = null;
            }
        }, { passive: false });

        body.addEventListener('touchend', (e) => {
            if (!touchSrc) return;
            touchClone?.remove(); touchClone = null;
            touchSrc.classList.remove('dragging');
            document.querySelectorAll('.queue-item.drag-over').forEach(el => el.classList.remove('drag-over'));
            const touch = e.changedTouches[0];
            const elUnder = document.elementFromPoint(touch.clientX, touch.clientY);
            const target  = elUnder?.closest('.queue-item');
            commitDrop(touchSrc, target);
            touchSrc = null; dragOverItem = null; isDragging = false;
        }, { passive: true });

        body.addEventListener('touchcancel', () => {
            touchClone?.remove(); touchClone = null;
            touchSrc?.classList.remove('dragging');
            document.querySelectorAll('.queue-item.drag-over').forEach(el => el.classList.remove('drag-over'));
            touchSrc = null; dragSrc = null; dragOverItem = null; isDragging = false;
        }, { passive: true });
    })();

    // ── UI Helpers ────────────────────────────────────────────────────────────
    function updateNowPlaying(track) {
        const img = track.album?.images?.[0]?.url || '';
        const art = document.getElementById('np-art');
        art.src = img; art.style.opacity = img ? '1' : '0';
        document.getElementById('np-name').textContent   = track.name;
        document.getElementById('np-name').style.color   = '';
        document.getElementById('np-artist').textContent = track.artists.map(a => a.name).join(', ');
    }

    function updatePlayPauseIcon() {
        document.getElementById('icon-play').style.display  = isPlaying ? 'none'  : 'block';
        document.getElementById('icon-pause').style.display = isPlaying ? 'block' : 'none';
    }

    function updateProgress() {
        const pct = currentDuration ? (currentPosition / currentDuration) * 100 : 0;
        document.getElementById('progress-fill').style.width = `${pct}%`;
        document.getElementById('time-current').textContent  = msToTime(currentPosition);
        document.getElementById('time-total').textContent    = msToTime(currentDuration);
    }

    function setStatus(type, msg) {
        const el  = document.getElementById('sdk-status');
        const bar = document.getElementById('sdk-status-bar');
        if (el)  { el.textContent  = msg; el.className  = type; }
        if (bar) { bar.textContent = msg; bar.className = type; }
    }

    function msToTime(ms) {
        const s = Math.floor(ms / 1000);
        return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    }

    let toastTimeout;
    function showToast(msg) {
        let t = document.getElementById('toast');
        if (!t) {
            t = document.createElement('div');
            t.id = 'toast';
            t.style.cssText = `position:fixed;bottom:104px;left:50%;transform:translateX(-50%);
                background:var(--green);color:#000;font-family:'DM Mono',monospace;
                font-size:0.75rem;font-weight:600;padding:8px 18px;border-radius:100px;
                z-index:300;opacity:0;transition:opacity 0.2s;pointer-events:none;`;
            document.body.appendChild(t);
        }
        t.textContent = msg; t.style.opacity = '1';
        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => { t.style.opacity = '0'; }, 2200);
    }

    // ── Fuzzy Search ──────────────────────────────────────────────────────────
    function fuzzyScore(str, query) {
        str = str.toLowerCase(); query = query.toLowerCase();
        if (str.startsWith(query)) return 0;
        if (str.includes(query))   return 1;
        let qi = 0, gaps = 0, last = -1;
        for (let i = 0; i < str.length && qi < query.length; i++) {
            if (str[i] === query[qi]) { gaps += last >= 0 ? i - last - 1 : 0; last = i; qi++; }
        }
        return qi < query.length ? Infinity : 2 + gaps;
    }

    function highlight(str, query) {
        if (!query) return str;
        const idx = str.toLowerCase().indexOf(query.toLowerCase());
        if (idx !== -1) return str.slice(0, idx) + `<span class="match">${str.slice(idx, idx + query.length)}</span>` + str.slice(idx + query.length);
        let r = '', qi = 0;
        for (const ch of str) {
            if (qi < query.length && ch.toLowerCase() === query[qi].toLowerCase()) { r += `<span class="match">${ch}</span>`; qi++; }
            else r += ch;
        }
        return r;
    }

    // ── Song row builder ──────────────────────────────────────────────────────
    function makeSongRow(song, i) {
        const row   = document.createElement('div');
        row.className = 'song-row';
        const query = document.getElementById('search').value.trim();
        row.innerHTML = `
            <span class="song-index" style="${song.uri === currentTrackUri ? 'color:var(--green)' : ''}">${i + 1}</span>
            ${song.image ? `<img class="song-art" src="${song.image}" alt="" />` : `<div class="song-art-placeholder"></div>`}
            <div class="song-info">
                <div class="song-name">${highlight(song.name, query)}</div>
                <div class="song-artist">${highlight(song.artist, query)}</div>
            </div>
            <div class="row-actions">
                <button class="btn-play">▶ play</button>
                <button class="btn-queue">+ queue</button>
            </div>`;
        row.querySelector('.btn-play').addEventListener('click',  () => playSong(song.uri, true));
        row.querySelector('.btn-queue').addEventListener('click', () => queueSong(song));
        return row;
    }

    function renderSongs(filtered) {
        const list       = document.getElementById('song-list');
        const noResults  = document.getElementById('no-results');
        const countLabel = document.getElementById('count-label');
        const query      = document.getElementById('search').value.trim();
        list.innerHTML   = '';

        if (filtered.length === 0) {
            noResults.style.display = 'block';
            countLabel.textContent  = 'NO RESULTS';
            return;
        }
        noResults.style.display = 'none';
        countLabel.textContent  = query
            ? `${filtered.length} RESULT${filtered.length !== 1 ? 'S' : ''}`
            : `${filtered.length} SONGS`;

        filtered.forEach((song, i) => list.appendChild(makeSongRow(song, i)));

        if (currentSource === 'liked' && !query && !likedExhausted) attachScrollSentinel();
    }

    // ── Search with clear button ──────────────────────────────────────────────
    const searchInput = document.getElementById('search');
    const searchClear = document.getElementById('btn-search-clear');

    searchInput.addEventListener('input', (e) => {
        const query = e.target.value.trim();
        searchClear.style.display = query ? '' : 'none';
        if (!query) { renderSongs(currentSongs); return; }
        const scored = currentSongs
            .map(s => ({ song: s, score: Math.min(fuzzyScore(s.name, query) * 0.5, fuzzyScore(s.artist, query)) }))
            .filter(s => s.score < Infinity).sort((a, b) => a.score - b.score);
        renderSongs(scored.map(s => s.song));
    });

    searchClear.addEventListener('click', () => {
        searchInput.value = '';
        searchClear.style.display = 'none';
        searchInput.focus();
        renderSongs(currentSongs);
    });

    // ── Switch source ─────────────────────────────────────────────────────────
    async function switchSource(sourceId, sourceName) {
        document.querySelectorAll('.source-item').forEach(el => {
            el.classList.toggle('active', el.dataset.source === sourceId);
        });
        currentSource = sourceId;
        document.getElementById('source-title').textContent = sourceName;
        searchInput.value = '';
        searchClear.style.display = 'none';

        if (sourceId === 'liked') {
            currentSongs = [...allSongs];
            document.getElementById('count-label').textContent = `${allSongs.length} SONGS`;
            renderSongs(currentSongs);
            return;
        }

        if (playlistCache[sourceId]) {
            currentSongs = playlistCache[sourceId];
            document.getElementById('count-label').textContent = `${currentSongs.length} SONGS`;
            renderSongs(currentSongs);
            return;
        }

        document.getElementById('count-label').textContent = 'LOADING...';
        document.getElementById('song-list').innerHTML = `
            <div style="padding:48px 0;text-align:center;color:var(--muted);font-size:0.8rem;">Loading tracks...</div>`;

        try {
            const res = await fetch(`/spotify/playlists/${sourceId}/tracks`);
            if (!res.ok) {
                if (res.status === 403) {
                    // Inaccessible — silently remove from sidebar and fall back
                    forbiddenPlaylists.add(sourceId);
                    document.querySelector(`.source-item[data-source="${sourceId}"]`)?.remove();
                    switchSource('liked', 'Liked Songs');
                } else {
                    document.getElementById('count-label').textContent = 'UNAVAILABLE';
                    document.getElementById('song-list').innerHTML = `
                        <div style="padding:48px 0;text-align:center;color:var(--muted);font-size:0.8rem;">
                            This playlist can't be loaded
                        </div>`;
                }
                return;
            }
            const songs = await res.json();
            playlistCache[sourceId] = songs;
            if (currentSource === sourceId) {
                currentSongs = songs;
                document.getElementById('count-label').textContent = `${songs.length} SONGS`;
                renderSongs(currentSongs);
            }
        } catch (e) {
            document.getElementById('count-label').textContent = 'ERROR';
        }
    }

    document.getElementById('source-liked').addEventListener('click', () => switchSource('liked', 'Liked Songs'));

    // ── Load playlists into sidebar ───────────────────────────────────────────
    async function loadPlaylists() {
        const container = document.getElementById('playlist-list');
        try {
            const res = await fetch('/spotify/playlists');
            const data = await res.json();

            if (!res.ok) {
                const retryMsg = data.retryAfter ? ` (retry in ${data.retryAfter}s)` : '';
                container.innerHTML = `<div style="padding:8px 14px;font-size:0.72rem;color:#e74c3c;font-style:italic;">
                    ${res.status === 429 ? `Rate limited by Spotify${retryMsg} — open the sidebar again in a moment` : (data.error || 'Failed to load')}
                    <br/><button onclick="playlistsLoaded=false;loadPlaylists()" style="margin-top:6px;background:none;border:1px solid var(--muted);color:var(--muted2);border-radius:4px;padding:3px 8px;cursor:pointer;font-size:0.68rem;">Retry</button>
                </div>`;
                return;
            }

            container.innerHTML = '';
            if (data.length === 0) {
                container.innerHTML = `<div style="padding:8px 14px;font-size:0.72rem;color:var(--muted);font-style:italic;">No playlists found</div>`;
                return;
            }

            data.filter(pl => !pl.isSpotifyOwned).forEach(pl => {
                const item = document.createElement('div');
                item.className = 'source-item';
                item.dataset.source = pl.id;
                item.innerHTML = `
                    ${pl.image
                        ? `<img class="source-art" src="${pl.image}" alt="${pl.name}" />`
                        : `<div class="source-art-placeholder"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/></svg></div>`}
                    <div class="source-info"><div class="source-name">${pl.name}</div></div>`;
                item.addEventListener('click', () => switchSource(pl.id, pl.name));
                container.appendChild(item);
            });
        } catch (e) {
            container.innerHTML = `<div style="padding:8px 14px;font-size:0.72rem;color:var(--muted);font-style:italic;">Failed to load</div>`;
        }

    }


    // ── Infinite scroll for liked songs ───────────────────────────────────────
    async function loadMoreLikedSongs() {
        if (likedLoading || likedExhausted || currentSource !== 'liked') return;
        likedLoading = true;
        try {
            const res = await fetch(`/spotify/liked?offset=${likedOffset}&limit=50`);
            if (!res.ok) { likedLoading = false; return; }
            const songs = await res.json();

            if (songs.length === 0) {
                likedExhausted = true;
                document.getElementById('scroll-sentinel')?.remove();
                likedLoading = false;
                return;
            }

            allSongs.push(...songs);
            likedOffset += songs.length;

            if (currentSource === 'liked') {
                currentSongs = [...allSongs];
                const list  = document.getElementById('song-list');
                const query = searchInput.value.trim();
                if (!query) {
                    const startIdx = allSongs.length - songs.length;
                    songs.forEach((song, i) => {
                        list.insertBefore(makeSongRow(song, startIdx + i), document.getElementById('scroll-sentinel'));
                    });
                    document.getElementById('count-label').textContent = `${allSongs.length} SONGS`;
                }
            }
        } catch (e) {}
        likedLoading = false;
    }

    function attachScrollSentinel() {
        document.getElementById('scroll-sentinel')?.remove();
        const sentinel = document.createElement('div');
        sentinel.id = 'scroll-sentinel';
        sentinel.style.height = '1px';
        document.getElementById('song-list').appendChild(sentinel);
        const observer = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) loadMoreLikedSongs();
        }, { rootMargin: '200px' });
        observer.observe(sentinel);
    }

    // ── Init ──────────────────────────────────────────────────────────────────
    renderSongs(currentSongs);
    renderQueue();
</script>
</body>
</html>
